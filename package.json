{
  "$schema": "https://www.schemastore.org/package.json",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run typecheck && npm run test:trajectory && npm run test:ai-voice && npm run test:pos && vite build",
    "test:highlevel-fleet": "node --test tests/e2e/highlevel-fleet*.test.mjs",
    "test:trajectory": "node --test tests/e2e/trajectory-money.test.mjs tests/e2e/trajectory-charts.test.mjs tests/e2e/trajectory-bank-link.test.mjs",
    "test:ai-voice": "node --test tests/e2e/ai-voice-conversation.test.mjs",
    "media:optimize-public": "node scripts/media/optimize-public-image.mjs",
    "test:visual": "playwright test --config=playwright.public.config.ts",
    "test:lighthouse:public": "lhci autorun --config=lighthouserc.public.cjs",
    "typecheck": "tsc -p tsconfig.workflows.json --noEmit",
    "dev": "vite",
    "serve": "php artisan serve",
    "dev:full": "concurrently -k -n \"LARAVEL,VITE\" -c \"green,blue\" \"php artisan serve\" \"npm run dev\"",
    "shopify:app:dev": "shopify app dev",
    "shopify:app:dev:wholesale": "shopify app dev --config wholesale",
    "shopify:app:deploy": "shopify app deploy",
    "shopify:app:deploy:wholesale": "shopify app deploy --config wholesale",
    "shopify:app:info": "shopify app info",
    "shopify:app:info:wholesale": "shopify app info --config wholesale",
    "qa:click-path": "node scripts/qa/click-path-audit.mjs",
    "qa:click-path:auth": "CLICK_PATH_CONFIG=tests/e2e/click-path-routes-auth.json node scripts/qa/click-path-audit.mjs",
    "test:team-preservation": "node --test scripts/everbranch-team/verify-source-export.test.mjs scripts/everbranch-team/asana-preservation-client.test.mjs scripts/everbranch-team/preview-note-fields.test.mjs",
    "test:team-work-local": "node --test scripts/everbranch-team/verify-source-export.test.mjs scripts/everbranch-team/asana-preservation-client.test.mjs scripts/everbranch-team/preview-note-fields.test.mjs scripts/everbranch-team/offline-queue.test.mjs scripts/everbranch-team/reconcile-import.test.mjs scripts/everbranch-team/parity-status.test.mjs && php scripts/everbranch-team/work-graph.test.php",
    "test:team-fixture": "node scripts/everbranch-team/fixture-acceptance.mjs",
    "test:team-laravel": "php vendor/bin/pest --configuration=phpunit.team.xml --compact",
    "test:team-laravel-browser": "node scripts/everbranch-team/laravel-acceptance.mjs",
    "test:team-laravel-views": "node scripts/everbranch-team/laravel-view-smoke.mjs",
    "team:parity": "node scripts/everbranch-team/build-parity-matrix.mjs",
    "test:pos": "node --test tests/e2e/pos-*.test.mjs"
  },
  "dependencies": {
    "@glideapps/glide-data-grid": "^6.0.3",
    "@shopify/polaris": "^13.9.5",
    "@shopify/polaris-icons": "^9.3.1",
    "@shopify/shopify_function": "~2.0.0",
    "@shopify/web-pixels-extension": "^2.18.0",
    "@stripe/connect-js": "^3.4.6",
    "@tailwindcss/vite": "^4.1.11",
    "autoprefixer": "^10.4.20",
    "axios": "^1.7.4",
    "chart.js": "^4.5.1",
    "cmdk": "^1.1.1",
    "fuse.js": "^7.2.0",
    "gsap": "^3.15.0",
    "laravel-vite-plugin": "^2.0",
    "leaflet": "1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.3",
    "sortablejs": "^1.15.7",
    "tailwindcss": "^4.0.7",
    "vite": "^7.0.4"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.9.5",
    "@tailwindcss/oxide-linux-x64-gnu": "^4.0.1",
    "lightningcss-linux-x64-gnu": "^1.29.1"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "playwright": "^1.54.2",
    "typescript": "^5.7.3"
  }
}
