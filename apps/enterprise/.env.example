# Separate Enterprise deployment only. Do not copy retail .env or credentials.
ENTERPRISE_APP_ENV=production
ENTERPRISE_APP_URL=https://enterprise.invalid
ENTERPRISE_APP_KEY=
# Set only after the independent database, runtime and credentials are reviewed.
ENTERPRISE_RUNTIME_ISOLATED=false
ENTERPRISE_DB_DRIVER=mysql
ENTERPRISE_DB_HOST=
ENTERPRISE_DB_PORT=3306
ENTERPRISE_DB_DATABASE=
ENTERPRISE_DB_USERNAME=
ENTERPRISE_DB_PASSWORD=
ENTERPRISE_ENABLED=false
ENTERPRISE_WRITES_ENABLED=false
ENTERPRISE_COLLABORATION_ENABLED=false
ENTERPRISE_PLANNING_ENABLED=false
ENTERPRISE_ASK_ENABLED=false
ENTERPRISE_EMAIL_DRAFTS_ENABLED=false
ENTERPRISE_FILE_SCANNER_ENABLED=false
# Independent scanner configuration is a later operator-reviewed activation.
ENTERPRISE_CLAMD_HOST=127.0.0.1
ENTERPRISE_CLAMD_PORT=3310
ENTERPRISE_TENANT_ALLOWLIST=
# This slice has no mail delivery, queue dispatch, billing or live providers.
