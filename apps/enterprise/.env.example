# Separate Enterprise deployment only. Do not copy retail .env or credentials.
ENTERPRISE_APP_ENV=production
ENTERPRISE_APP_URL=https://enterprise.invalid
ENTERPRISE_APP_KEY=
# Set only after the independent database, runtime and credentials are reviewed.
ENTERPRISE_RUNTIME_ISOLATED=false
# Optional full private workspace mount, e.g. /enterprise-campus; empty means standalone.
ENTERPRISE_BASE_PATH=
# Full prefix mounts require the matching session path and trial/Gmail flags disabled.
# Optional same-origin trial prefix mount. Both settings are required together.
ENTERPRISE_TRIAL_MOUNT_ONLY=false
ENTERPRISE_SESSION_PATH=/
# For an approved /enterprise/trial mount: true and /enterprise/trial respectively.
ENTERPRISE_DB_DRIVER=mysql
ENTERPRISE_DB_HOST=
ENTERPRISE_DB_PORT=3306
ENTERPRISE_DB_DATABASE=
ENTERPRISE_DB_USERNAME=
ENTERPRISE_DB_PASSWORD=
ENTERPRISE_ENABLED=false
ENTERPRISE_WRITES_ENABLED=false
ENTERPRISE_COLLABORATION_ENABLED=false
ENTERPRISE_PLANNING_ENABLED=false
ENTERPRISE_ASK_ENABLED=false
ENTERPRISE_EMAIL_DRAFTS_ENABLED=false
ENTERPRISE_WORKFLOW_ENABLED=false
ENTERPRISE_BRIEFING_ENABLED=false
ENTERPRISE_OPERATIONS_ENABLED=false
ENTERPRISE_RESOURCES_ENABLED=false
ENTERPRISE_ROLL_CALL_ENABLED=false
ENTERPRISE_REQUESTER_ENABLED=false
ENTERPRISE_REVIEWER_DEMO_ENABLED=false
# Navigation-only tour in a trusted persistent fictional workspace; no sample transport.
ENTERPRISE_TOUR_ENABLED=false
# Trusted fixture designation, never inferred from a college name or user input.
ENTERPRISE_SAMPLE_DATA=false
# Independent owner-approved provider configuration. Never copy retail credentials.
ENTERPRISE_AI_ENABLED=false
ENTERPRISE_AI_API_KEY=
ENTERPRISE_AI_MODEL=
ENTERPRISE_AI_INPUT_RATE_MICROUSD_PER_MILLION=0
ENTERPRISE_AI_OUTPUT_RATE_MICROUSD_PER_MILLION=0
ENTERPRISE_AI_RATES_VALID_UNTIL=
ENTERPRISE_AI_LIFETIME_CAP_MICROUSD=0
ENTERPRISE_AI_TENANT_ALLOWLIST=
ENTERPRISE_MAILBOX_ENABLED=false
ENTERPRISE_MAILBOX_SEND_ENABLED=false
ENTERPRISE_MAILBOX_ALLOWED_IDS=
ENTERPRISE_MAIL_DIRECT_ENABLED=false
ENTERPRISE_MAIL_SUBMISSION_HOST=
ENTERPRISE_MAIL_SUBMISSION_PORT=587
# Register the exact independent HTTPS /enterprise/gmail/callback URI only after approval.
# No GOOGLE_* login credential or existing grant is inherited.
ENTERPRISE_GMAIL_CONNECTION_ENABLED=false
ENTERPRISE_GMAIL_SEND_ENABLED=false
ENTERPRISE_GMAIL_CLIENT_ID=
ENTERPRISE_GMAIL_CLIENT_SECRET=
ENTERPRISE_GMAIL_REDIRECT_URI=
ENTERPRISE_GMAIL_TENANT_ALLOWLIST=
ENTERPRISE_FILE_SCANNER_ENABLED=false
# Independent scanner configuration is a later operator-reviewed activation.
ENTERPRISE_CLAMD_HOST=127.0.0.1
ENTERPRISE_CLAMD_PORT=3310
ENTERPRISE_TENANT_ALLOWLIST=
# No connections, grants, messages or provider spend are created by this template.

# Set ENTERPRISE_RUNTIME_ROOT in the trusted process environment BEFORE bootstrap.
# It selects an explicitly prepared private root with its own .env/storage/bootstrap/cache.
# These immutable identities must match the reviewed client manifest.
ENTERPRISE_CLIENT_ID=
ENTERPRISE_SILO_ID=
ENTERPRISE_CLIENT_ENVIRONMENT=
ENTERPRISE_CLIENT_DATABASE=
ENTERPRISE_CLIENT_STORAGE_ID=
ENTERPRISE_REPORTS_ENABLED=false
ENTERPRISE_CERTIFICATES_ENABLED=false
ENTERPRISE_FINANCE_ENABLED=false
ENTERPRISE_PWA_ENABLED=false
# Optional nonsecret release identifier; otherwise the fixed app assets are fingerprinted.
ENTERPRISE_RELEASE_ID=
ENTERPRISE_CERTIFICATES_TIMEZONE=America/New_York

# Controlled server-held synthetic reviewer trial; never inherits retail providers.
# One shared lifetime $5 cap includes verified prior/acceptance spend. Unknown blocks IO.
ENTERPRISE_TRIAL_ENABLED=false
ENTERPRISE_TRIAL_TENANT_ID=
ENTERPRISE_TRIAL_AREA_ID=
ENTERPRISE_TRIAL_CANONICAL_ORIGIN=
ENTERPRISE_TRIAL_PRIOR_SPEND_VERIFIED=false
ENTERPRISE_TRIAL_PRIOR_SPEND_MICROUSD=0
ENTERPRISE_TRIAL_PRIOR_SPEND_EVIDENCE=
# Approved invitation hashes/expiries/exact destination allowlists; see runbook.
ENTERPRISE_TRIAL_REVIEWERS_JSON={}
ENTERPRISE_TRIAL_RATES_VALID_UNTIL=
ENTERPRISE_TRIAL_ACCEPTANCE_MAX_COST_MICROUSD=0
ENTERPRISE_TRIAL_SMS_ENABLED=false
ENTERPRISE_TRIAL_TWILIO_ACCOUNT_SID=
ENTERPRISE_TRIAL_TWILIO_AUTH_TOKEN=
ENTERPRISE_TRIAL_SMS_FROM_NUMBER=
ENTERPRISE_TRIAL_SMS_SENDER_VERIFIED=false
ENTERPRISE_TRIAL_SMS_SENDER_EVIDENCE=
ENTERPRISE_TRIAL_SMS_MAX_COST_MICROUSD_PER_SEGMENT=0
ENTERPRISE_TRIAL_EMAIL_ENABLED=false
ENTERPRISE_TRIAL_SENDGRID_API_KEY=
ENTERPRISE_TRIAL_EMAIL_FROM=
ENTERPRISE_TRIAL_EMAIL_SENDER_VERIFIED=false
ENTERPRISE_TRIAL_EMAIL_SENDER_EVIDENCE=
ENTERPRISE_TRIAL_EMAIL_MAX_COST_MICROUSD=0
ENTERPRISE_TRIAL_AI_ENABLED=false
ENTERPRISE_TRIAL_AI_API_KEY=
ENTERPRISE_TRIAL_AI_MODEL=
ENTERPRISE_TRIAL_AI_INPUT_RATE_MICROUSD_PER_MILLION=0
ENTERPRISE_TRIAL_AI_OUTPUT_RATE_MICROUSD_PER_MILLION=0
