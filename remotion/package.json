{
  "name": "everbranch-story-film",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "render:story": "remotion render src/index.ts EverbranchStory ../public/media/everbranch-story.mp4 --codec=h264 --crf=20 --pixel-format=yuv420p",
    "render:rickroll-intro": "remotion render src/index.ts EverbranchStoryRickrollIntro ../public/media/everbranch-story-rickroll-intro.mp4 --codec=h264 --crf=20 --pixel-format=yuv420p",
    "still": "remotion still src/index.ts EverbranchStory ../public/media/everbranch-story-poster.jpg --frame=150"
  },
  "dependencies": {
    "@remotion/cli": "4.0.507",
    "@remotion/renderer": "4.0.507",
    "remotion": "4.0.507",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "typescript": "5.7.3"
  }
}
