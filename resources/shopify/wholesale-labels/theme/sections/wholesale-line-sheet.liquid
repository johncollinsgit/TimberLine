.wholesale-line-sheet .mf-order-message.is-error { color: #a23422; }
.wholesale-line-sheet .mf-order-table-wrap { overflow: hidden; border: 1px solid var(--mf-rule); border-radius: 24px; background: var(--mf-card); }
