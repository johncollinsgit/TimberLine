{% comment %}
  Wholesale Line Sheet (gated) — Modern Forestry Wholesale
  Polished UI + smoother motion + FIXED grid layout (no more 260px squeeze)

  Gates:
    • Logged in + tagged "wholesale"  → show catalog
    • Logged in but NOT tagged        → show apply invite
    • Not logged in                   → show login/apply invite

  Improvements:
    - Catalog UI restyle to match your wholesale application “soft card” vibe
    - Smooth focus mode + open/close without full re-render
    - FIX: filter panel no longer uses inline display:none (prevents grid collapsing)
    - Quantity updates use Shopify's cart add/change endpoints and remain in sync with the live cart
{% endcomment %}

{%- capture wholesale_guard_state -%}{%- render 'wholesale-guard' -%}{%- endcapture -%}
{%- assign wholesale_guard_parts = wholesale_guard_state | strip | split: '|' -%}
{%- assign is_logged_in = false -%}
{%- if wholesale_guard_parts[0] == 'true' -%}
  {%- assign is_logged_in = true -%}
{%- endif -%}
{%- assign has_wholesale_access = false -%}
{%- if wholesale_guard_parts[1] == 'true' -%}
  {%- assign has_wholesale_access = true -%}
{%- endif -%}

<script>
  (function () {
    // If they tried to access the line sheet, remember it
    const target = "/pages/wholesale-line-sheet";
    const key = "mf_post_login_return";

    // If we're ON the line sheet gate (not logged in), set the intent
    if (location.pathname === target) {
      sessionStorage.setItem(key, target);
    }

    // If Shopify dumps them on /account (common), bounce them back
    if (location.pathname === "/account" || location.pathname.startsWith("/account/")) {
      const desired = sessionStorage.getItem(key);
      if (desired) {
        sessionStorage.removeItem(key);
        location.replace(desired);
      }
    }
  })();
</script>

{% if is_logged_in == false %}
  <section class="wl-gate-shell">
    <div class="wl-gate-inner page-width">

      <div class="wl-gate-hero">
        <div class="wl-gate-pill">
          <span class="wl-gate-pill__dot" aria-hidden="true"></span>
          <span>Wholesale</span>
        </div>

        <h1 class="wl-gate-h1">Wholesale login required.</h1>
        <p class="wl-gate-sub">
          Please log in to your approved wholesale account to place an order.
          If you don’t have access yet, you can apply below.
        </p>
      </div>

      <div class="wl-gate-card" role="region" aria-label="Wholesale access">
        <div class="wl-gate-card__top">
          <div class="wl-gate-actions">
            <a class="wl-btn wl-btn--primary"
               href="{{ routes.account_login_url }}?return_url={{ request.path | url_encode }}&return_to={{ request.path | url_encode }}">
              Log in
            </a>

            <a class="wl-btn wl-btn--secondary" href="/pages/wholesale-application-1">Apply for wholesale</a>
          </div>

          <div class="wl-match" aria-label="Strike a match">
            <button class="wl-match__btn" type="button">
              <span class="wl-match__match" aria-hidden="true"></span>
              <span class="wl-match__striker" aria-hidden="true"></span>
              <span class="wl-match__label">Strike a match</span>
            </button>

            <div class="wl-match__note"
              role="status"
              aria-live="polite"
              data-note-default="Tip: click the match. We’ll keep it warm in here.">
              Tip: click the match. We’ll keep it warm in here.
            </div>

            <div class="wl-fx" aria-hidden="true">
              <div class="wl-glow"></div>
              <div class="wl-flame"></div>
              <canvas class="wl-embers" width="1" height="1"></canvas>
            </div>

            <div class="wl-logo" aria-hidden="true">
              {% if settings.logo != blank %}
                <img
                  class="wl-logo__img"
                  src="{{ settings.logo | image_url: width: 320 }}"
                  alt="{{ shop.name | escape }}"
                  loading="lazy"
                  width="320"
                  height="120"
                >
              {% else %}
                <div class="wl-logo__fallback">Modern Forestry</div>
              {% endif %}
            </div>
          </div>
        </div>
      </div>

    </div>
  </section>

{% elsif has_wholesale_access == false %}
  <section class="wl-gate-shell">
    <div class="wl-gate-inner page-width">

      <div class="wl-gate-hero">
        <div class="wl-gate-pill">
          <span class="wl-gate-pill__dot" aria-hidden="true"></span>
          <span>Wholesale</span>
        </div>

        <h1 class="wl-gate-h1">Wholesale access required.</h1>
        <p class="wl-gate-sub">
          You’re logged in, but this account isn’t approved for wholesale ordering yet.
          Apply below and we’ll get you set up.
        </p>
      </div>

      <div class="wl-gate-card" role="region" aria-label="Wholesale access">
        <div class="wl-gate-card__top">
          <div class="wl-gate-actions">
            <a class="wl-btn wl-btn--primary" href="/pages/wholesale-application-1">Apply for wholesale</a>
            <a class="wl-btn wl-btn--secondary" href="{{ routes.account_url }}">My Account</a>
            <a class="wl-btn wl-btn--secondary" href="mailto:modernforestryteam@gmail.com">Contact Us</a>
          </div>

          <div class="wl-match" aria-label="Strike a match">
            <button class="wl-match__btn" type="button">
              <span class="wl-match__match" aria-hidden="true"></span>
              <span class="wl-match__striker" aria-hidden="true"></span>
              <span class="wl-match__label">Strike a match</span>
            </button>

            <div class="wl-match__note"
              role="status"
              aria-live="polite"
              data-note-default="We review applications by hand — usually within 1–2 business days.">
              We review applications by hand — usually within 1–2 business days.
            </div>

            <div class="wl-fx" aria-hidden="true">
              <div class="wl-glow"></div>
              <div class="wl-flame"></div>
              <canvas class="wl-embers" width="1" height="1"></canvas>
            </div>

            <div class="wl-logo" aria-hidden="true">
              {% if settings.logo != blank %}
                <img
                  class="wl-logo__img"
                  src="{{ settings.logo | image_url: width: 320 }}"
                  alt="{{ shop.name | escape }}"
                  loading="lazy"
                  width="320"
                  height="120"
                >
              {% else %}
                <div class="wl-logo__fallback">Modern Forestry</div>
              {% endif %}
            </div>
          </div>
        </div>
      </div>

    </div>
  </section>

{% else %}
  {%- comment -%} ====== START: Wholesale catalog code ====== {%- endcomment -%}

  {% if collections.wholesale and collections.wholesale.products.size > 0 %}
    <div class="wholesale-line-sheet" data-mf-wholesale>
      <div class="mf-wl-intro page-width">
        <p class="mf-wl-eyebrow">Modern Forestry wholesale</p>
        <div>
          <h1>{{ 'wholesale.line_sheet.title' | t }}</h1>
          <p>{{ 'wholesale.line_sheet.intro' | t }}</p>
        </div>
        <img class="mf-wl-intro__art" src="{{ 'mf-painted-woodland.webp' | asset_url }}" alt="" aria-hidden="true" width="1600" height="595">
      </div>

      <div class="mf-wl-layout page-width" id="mfWlLayout">
        <aside id="filterPanel" class="collection-filter" aria-label="Filters">
          <div class="mf-filter-head">
            <strong>Browse by collection</strong>
          </div>

          <ul class="mf-filter-list">
            <li><button class="filter-btn" data-collection="Winter Collection" type="button">Winter</button></li>
            <li><button class="filter-btn" data-collection="Spring Collection" type="button">Spring</button></li>
            <li><button class="filter-btn" data-collection="Summer Collection" type="button">Summer</button></li>
            <li><button class="filter-btn" data-collection="Autumn Collection" type="button">Autumn</button></li>
            <li><button class="filter-btn" data-collection="Classic Collection" type="button">Classic</button></li>
            <li><button class="filter-btn active" data-collection="All" type="button">Show all</button></li>
          </ul>
        </aside>

        <main class="mf-wl-main">
          <div class="toolbar-shell">
            <div class="toolbar-row" role="region" aria-label="Wholesale tools">
              <div class="mf-order-summary">
                <span>Your order</span>
                <strong id="cartTotal">$0.00</strong>
                <small id="cartProgress">Add $150.00 to reach the order minimum.</small>
              </div>

              <div class="toolbar-left">
                <button class="filter-btn-icon" type="button">
                  <span aria-hidden="true">☰</span> Collections
                </button>

                <div class="sort-dropdown">
                  <button class="sort-btn" type="button" aria-haspopup="listbox" aria-expanded="false">Sort <span aria-hidden="true">⌄</span></button>
                  <ul class="sort-options" role="listbox" style="display:none;">
                    <li role="option" tabindex="0" data-sort="az">Alphabetical A → Z</li>
                    <li role="option" tabindex="0" data-sort="za">Alphabetical Z → A</li>
                    <li role="option" tabindex="0" data-sort="newest">Newest scents on top</li>
                  </ul>
                </div>
              </div>

              <div class="search-bar-container">
                <input type="text" id="productSearchInput" placeholder="{{ 'wholesale.line_sheet.search' | t }}" aria-label="{{ 'wholesale.line_sheet.search' | t }}" />
                <span class="search-icon" aria-hidden="true">🔍</span>
              </div>

              <div class="toolbar-cart">
                <a id="cartSummary" class="cart-icon-button" href="{{ routes.cart_url }}">
                  Review order <span id="cartCount">0 items</span>
                </a>
              </div>

              <div class="reset-cart-wrapper">
                <button class="reset-cart-button" type="button" onclick="resetWholesaleCart()">Clear order</button>
              </div>
            </div>
            <p class="toolbar-meta">{{ 'wholesale.line_sheet.rules' | t }}</p>
          </div>

          <p id="cartMessage" class="mf-order-message" role="status" aria-live="polite"></p>

          <div class="mf-order-table-wrap">
            <table id="productGrid" class="product-grid">
              <caption class="visually-hidden">{{ 'wholesale.line_sheet.caption' | t }}</caption>
              <colgroup><col class="mf-col-product"><col class="mf-col-size"><col class="mf-col-price"><col class="mf-col-quantity"><col class="mf-col-total"></colgroup>
              <thead><tr>
                <th scope="col">{{ 'wholesale.line_sheet.product' | t }}</th>
                <th scope="col">{{ 'wholesale.line_sheet.size' | t }}</th>
                <th scope="col">{{ 'wholesale.line_sheet.unit_price' | t }}</th>
                <th scope="col">{{ 'wholesale.line_sheet.quantity' | t }}</th>
                <th scope="col">{{ 'wholesale.line_sheet.total' | t }}</th>
              </tr></thead>
            </table>
          </div>

          <div id="noResultsMessage" class="mf-empty" style="display:none;">
            No products found matching your search.
          </div>
        </main>
      </div>

      <!-- Product JSON -->
      {% capture wholesale_json %}[
        {% paginate collections.wholesale.products by 250 %}
          {% assign first = true %}
          {% for product in collections.wholesale.products %}
            {% assign season_label = 'Uncategorized' %}
            {% assign tag_string = product.tags | join: ',' %}

            {% if tag_string contains 'Winter Collection' %}
              {% assign season_label = 'Winter Collection' %}
            {% elsif tag_string contains 'Spring Collection' %}
              {% assign season_label = 'Spring Collection' %}
            {% elsif tag_string contains 'Summer Collection' %}
              {% assign season_label = 'Summer Collection' %}
            {% elsif tag_string contains 'Autumn Collection' %}
              {% assign season_label = 'Autumn Collection' %}
            {% elsif tag_string contains 'Classic Collection' %}
              {% assign season_label = 'Classic Collection' %}
            {% endif %}

            {% unless first %},{% endunless %}
            {% assign first = false %}
            {
              "title": {{ product.title | json }},
              "handle": {{ product.handle | json }},
              "season": {{ season_label | json }},
              "image": {% if product.featured_image %}{{ product.featured_image | image_url: width: 640 | json }}{% else %}null{% endif %},
              "variants": [
                {% for variant in product.variants %}
                  {
                    "id": {{ variant.id }},
                    "name": {{ variant.title | json }},
                    "price": {{ variant.price | divided_by: 100.0 }},
                    "sku": {{ variant.sku | json }},
                    "available": {{ variant.available | json }},
                    "increment": {% render 'mf-order-increment', product: product, variant: variant %}
                  }{% unless forloop.last %},{% endunless %}
                {% endfor %}
              ]
            }
          {% endfor %}
        {% endpaginate %}
      ]{% endcapture %}

      <script id="wholesale-products-json" type="application/json">{{ wholesale_json | strip_newlines }}</script>
    </div>
  {% else %}
    <div class="page-width" style="padding:3rem 0; text-align:center;">
      <p style="color:red;">
        ⚠️ No products found in the <strong>wholesale</strong> collection.<br>
        Make sure the collection exists, is published, and has products assigned to it.
      </p>
    </div>
  {% endif %}

  {%- comment -%} ====== END: Wholesale catalog code ====== {%- endcomment -%}
{% endif %}

<style>
  * { box-sizing: border-box; }

  /* =========================
     Wholesale Gate (matches form vibe)
     ========================= */
  .wl-gate-shell{
    position: relative;
    min-height: calc(100vh - 180px);
    padding: clamp(28px, 5vw, 64px) 0;
    display: grid;
    place-items: center;
    background: radial-gradient(1200px 600px at 50% -100px, rgba(0,0,0,.06), transparent 70%);
  }

  .wl-gate-inner{ width: 100%; max-width: 980px; }

  .wl-gate-hero{
    text-align: left;
    margin: 0 auto clamp(16px, 3vw, 22px);
    max-width: 920px;
  }

  .wl-gate-pill{
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    border-radius: 999px;
    background: rgba(0,0,0,.04);
    border: 1px solid rgba(0,0,0,.08);
    font-weight: 600;
    letter-spacing: .2px;
    margin-bottom: 16px;
  }

  .wl-gate-pill__dot{
    width: 10px; height: 10px; border-radius: 50%;
    background: rgba(0,0,0,.35);
    box-shadow: 0 0 0 3px rgba(0,0,0,.08);
  }

  .wl-gate-h1{
    margin: 0 0 10px;
    font-size: clamp(34px, 4.2vw, 56px);
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  .wl-gate-sub{
    margin: 0;
    max-width: 760px;
    font-size: clamp(15px, 1.6vw, 18px);
    line-height: 1.5;
    opacity: .78;
  }

  .wl-gate-card{
    margin-top: clamp(14px, 2vw, 18px);
    border-radius: 18px;
    background: #fff;
    border: 1px solid rgba(0,0,0,.10);
    box-shadow: 0 10px 30px rgba(0,0,0,.08);
    overflow: hidden;
  }

  .wl-gate-card__top{
    padding: clamp(18px, 2.6vw, 26px);
    display: grid;
    gap: 16px;
  }

  .wl-gate-actions{
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .wl-btn{
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 18px;
    border-radius: 14px;
    font-weight: 700;
    text-decoration: none;
    border: 1px solid rgba(0,0,0,.12);
    transition: transform .12s ease, box-shadow .12s ease, background-color .12s ease;
    min-width: 180px;
  }

  .wl-btn:active{ transform: translateY(1px); }

  .wl-btn--primary{
    background: rgba(0,0,0,.88);
    color: #fff;
    border-color: rgba(0,0,0,.88);
    box-shadow: 0 10px 24px rgba(0,0,0,.16);
  }

  .wl-btn--primary:hover{ background: rgba(0,0,0,.94); }

  .wl-btn--secondary{
    background: rgba(0,0,0,.03);
    color: rgba(0,0,0,.88);
  }

  .wl-btn--secondary:hover{ background: rgba(0,0,0,.05); }

  .wl-match{
    position: relative;
    border-radius: 16px;
    border: 1px solid rgba(0,0,0,.08);
    background: linear-gradient(180deg, rgba(0,0,0,.02), rgba(0,0,0,.01));
    padding: 16px;
    display: grid;
    gap: 10px;
    align-items: center;
  }

  .wl-match__btn{
    width: max-content;
    max-width: 100%;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    border: 0;
    background: transparent;
    cursor: pointer;
    padding: 10px 12px;
    border-radius: 999px;
    border: 1px solid rgba(0,0,0,.10);
    transition: transform .12s ease, box-shadow .12s ease, border-color .12s ease;
    position: relative;
    overflow: hidden;
  }

  .wl-match__btn:hover{
    transform: translateY(-1px);
    border-color: rgba(0,0,0,.18);
    box-shadow: 0 10px 22px rgba(0,0,0,.08);
  }

  .wl-match__label{ font-weight: 700; }
  .wl-match__note{ font-size: 13px; opacity: .72; }

  .wl-match__match{
    width: 56px; height: 10px; border-radius: 999px;
    background: linear-gradient(90deg, #caa06a 0%, #b07b44 72%, #8a2b2b 72%, #8a2b2b 100%);
    position: relative;
    transform: translateX(0);
  }

  .wl-match__match::after{
    content:"";
    position:absolute;
    right:-6px; top:50%;
    transform: translateY(-50%);
    width:12px; height:12px; border-radius:4px;
    background:#8a2b2b;
    box-shadow: inset 0 0 0 2px rgba(255,255,255,.18);
  }

  .wl-match__striker{
    width: 36px; height: 12px; border-radius: 999px;
    background: repeating-linear-gradient(45deg, rgba(0,0,0,.18) 0 4px, rgba(0,0,0,.08) 4px 8px);
    border: 1px solid rgba(0,0,0,.12);
    opacity: .9;
  }

  .wl-sparks{ position:absolute; width:1px; height:1px; pointer-events:none; opacity:0; left:0; top:0; }
  .wl-match.is-striking .wl-sparks{ opacity:1; animation: wlSparks 520ms ease-out both; }

  .wl-fx{
    position: absolute;
    inset: 0;
    pointer-events: none;
    --fx-x: 50%;
    --fx-y: 58px;
  }

  .wl-glow{
    position:absolute;
    inset:-80px -80px -60px -80px;
    border-radius: 32px;
    opacity: 0;
    transition: opacity .35s ease;
    background: radial-gradient(520px 230px at 50% 30%, rgba(255,183,77,.18), transparent 62%);
  }

  .wl-flame{
    position:absolute;
    left: var(--fx-x);
    top:  var(--fx-y);
    transform: translate(-50%, -50%) scale(.6);
    width: 18px; height: 28px;
    border-radius: 50% 50% 45% 45%;
    opacity: 0;
    background: radial-gradient(circle at 60% 70%,
      rgba(255,255,255,.95),
      rgba(255,196,61,.95) 35%,
      rgba(255,122,0,.92) 70%,
      rgba(160,30,0,.86) 100%);
    filter: drop-shadow(0 0 10px rgba(255,163,26,.45));
    transition: opacity .25s ease, transform .25s ease;
  }

  .wl-embers{
    position:absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
  }

  .wl-logo{
    display: grid;
    place-items: center;
    margin-top: 10px;
    opacity: 0;
    transform: translateY(8px) scale(.98);
    transition: opacity .4s ease, transform .4s ease;
  }

  .wl-logo__img{
    display:block;
    max-width: 220px;
    width: 100%;
    height: auto;
    filter: drop-shadow(0 18px 28px rgba(0,0,0,.12));
  }

  .wl-logo__fallback{
    font-weight: 800;
    letter-spacing: .04em;
    opacity: .72;
    padding: .6rem 1rem;
    border-radius: 16px;
    background: rgba(255,255,255,.75);
    box-shadow: 0 12px 24px rgba(0,0,0,.10);
  }

  .wl-match.is-striking .wl-glow{ opacity: .22; }
  .wl-match.is-burning .wl-flame{
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
    animation: wlFlicker 1.15s infinite ease-in-out;
  }

  .wl-match.is-rising .wl-flame{
    animation: wlRise 3.8s ease-in-out both, wlFlicker 1.1s infinite ease-in-out;
  }

  .wl-match.is-embers .wl-embers{ opacity: 1; }
  .wl-match.is-logo .wl-logo{ opacity: 1; transform: translateY(0) scale(1); }
  .wl-match.is-striking .wl-match__match{ animation: wlStrike 520ms cubic-bezier(.2,.9,.2,1) both; }
  .wl-match.is-striking .wl-match__btn{ animation: wlShake 520ms ease-out both; }

  .wl-warm-overlay{
    position: fixed;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    transition: opacity .35s ease;
    z-index: 9999;
    background:
      radial-gradient(900px 420px at 50% 18%, rgba(255, 190, 110, .22), transparent 60%),
      radial-gradient(700px 360px at 20% 70%, rgba(255, 160, 70, .12), transparent 62%),
      radial-gradient(700px 360px at 80% 70%, rgba(255, 160, 70, .12), transparent 62%);
    mix-blend-mode: screen;
  }

  body.wl-warm .wl-warm-overlay{
    opacity: 1;
    animation: wlWarmPulse 1.1s ease-in-out both;
  }

  @keyframes wlWarmPulse{
    0%{ opacity:0; }
    18%{ opacity:1; }
    70%{ opacity:.85; }
    100%{ opacity:0; }
  }

  @keyframes wlStrike{
    0%{ transform: translateX(0) rotate(0deg); }
    55%{ transform: translateX(18px) rotate(-6deg); }
    100%{ transform: translateX(26px) rotate(-10deg); }
  }

  @keyframes wlShake{
    0%{ transform: translateY(0); }
    35%{ transform: translateY(-1px); }
    70%{ transform: translateY(0); }
    100%{ transform: translateY(0); }
  }

  @keyframes wlFlicker{
    0%{ filter: drop-shadow(0 0 10px rgba(255,163,26,.42)); }
    40%{ filter: drop-shadow(0 0 14px rgba(255,163,26,.58)); }
    100%{ filter: drop-shadow(0 0 10px rgba(255,163,26,.42)); }
  }

  @keyframes wlRise{
    0%{ transform: translate(-50%, -50%) scale(1); }
    60%{ transform: translate(-50%, calc(-50% - 85px)) scale(1.25); }
    100%{ transform: translate(-50%, calc(-50% - 110px)) scale(.9); opacity: .85; }
  }

  @keyframes wlSparks{
    0%{
      transform: translate(0,0) scale(.8);
      filter: blur(0);
      box-shadow:
        0 0 0 0 rgba(255,200,60,.0),
        0 0 0 0 rgba(255,140,0,.0),
        0 0 0 0 rgba(255,240,200,.0);
    }
    22%{
      box-shadow:
        8px -10px 0 0 rgba(255,200,60,.95),
        14px -2px  0 0 rgba(255,140,0,.85),
        6px  -2px  0 0 rgba(255,240,200,.9),
        18px -14px 0 0 rgba(255,200,60,.75),
        10px  2px  0 0 rgba(255,140,0,.65);
    }
    100%{
      transform: translate(10px,-6px) scale(1.1);
      filter: blur(.2px);
      box-shadow:
        18px -18px 0 0 rgba(255,200,60,0),
        24px -6px  0 0 rgba(255,140,0,0),
        16px -8px  0 0 rgba(255,240,200,0),
        26px -24px 0 0 rgba(255,200,60,0),
        14px  0px  0 0 rgba(255,140,0,0);
    }
  }

  @media (max-width: 640px){
    .wl-btn{ width: 100%; min-width: 0; }
    .wl-match__btn{ width: 100%; justify-content: center; }
  }

  /* =========================
     Catalog (Line Sheet) — Modern Forestry style
     ========================= */
  .wholesale-line-sheet{
    --bg: #f6f6f5;
    --card: #ffffff;
    --ink: rgba(0,0,0,.88);
    --muted: rgba(0,0,0,.62);
    --line: rgba(0,0,0,.10);
    --line-2: rgba(0,0,0,.14);
    --shadow: 0 10px 30px rgba(0,0,0,.06);
    --radius: 18px;
    --radius-sm: 14px;
    --sticky-top: 14px;

    font-family: system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif;
    padding: clamp(18px, 2.6vw, 32px);
    background: var(--bg);
  }

  /* IMPORTANT: default is single-column; filters hidden.
     When filters open, we add .has-filters to switch to 2 columns. */
  .mf-wl-layout{
    display: grid;
    grid-template-columns: 1fr;
    gap: 18px;
    align-items: start;
  }

  .mf-wl-layout.has-filters{
    grid-template-columns: 260px 1fr;
  }

  .mf-wl-main{ min-width: 0; }

  .collection-filter{
    display: none;
    border: 1px solid var(--line);
    background: var(--card);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    padding: 14px;
  }

  .mf-wl-layout.has-filters .collection-filter{
    display: block;
    position: sticky;
    top: 16px;
  }

  .mf-filter-head{
    display:flex;
    align-items:center;
    justify-content: space-between;
    padding: 8px 8px 10px;
    border-bottom: 1px solid rgba(0,0,0,.06);
    margin-bottom: 10px;
  }

  .mf-filter-list{ list-style:none; padding:0; margin:0; display:grid; gap:8px; }

  .filter-btn{
    width: 100%;
    text-align: left;
    border-radius: 999px;
    border: 1px solid rgba(0,0,0,.10);
    background: rgba(0,0,0,.02);
    padding: 10px 12px;
    font-weight: 700;
    cursor: pointer;
    transition: transform .12s ease, background-color .12s ease, border-color .12s ease;
  }

  .filter-btn:hover{
    background: rgba(0,0,0,.04);
    border-color: rgba(0,0,0,.14);
    transform: translateY(-1px);
  }

  .filter-btn.active{
    background: rgba(0,0,0,.88);
    border-color: rgba(0,0,0,.88);
    color: #fff;
  }

  /* Toolbar */
  .toolbar-shell{
    position: sticky;
    top: var(--sticky-top);
    z-index: 20;
    margin-bottom: 14px;
    padding: 10px;
    border-radius: 16px;
    border: 1px solid rgba(0,0,0,.09);
    background: rgba(255,255,255,.84);
    backdrop-filter: blur(10px);
    box-shadow: 0 12px 28px rgba(0,0,0,.08);
  }

  .toolbar-row{
    display: grid;
    grid-template-columns: auto 1fr auto auto;
    gap: 10px;
    align-items: center;
    padding: 0;
  }

  .toolbar-left{
    display:flex;
    gap: 10px;
    align-items:center;
    flex-shrink: 0;
  }

  .toolbar-meta{
    margin: 8px 4px 0;
    color: var(--muted);
    font-size: 12px;
    letter-spacing: .02em;
    font-weight: 700;
  }

  .cart-icon-button,
  .filter-btn-icon,
  .sort-btn,
  .reset-cart-button{
    height: 44px;
    padding: 0 14px;
    border-radius: 12px;
    border: 1px solid var(--line-2);
    background: var(--card);
    font-weight: 800;
    cursor:pointer;
    display:flex;
    align-items:center;
    justify-content:center;
    gap: 8px;
    text-decoration:none;
    color: var(--ink);
    transition: transform .12s ease, box-shadow .12s ease, border-color .12s ease, background-color .12s ease;
    box-shadow: 0 2px 10px rgba(0,0,0,.04);
    white-space: nowrap;
  }

  .cart-icon-button:hover,
  .filter-btn-icon:hover,
  .sort-btn:hover,
  .reset-cart-button:hover{
    transform: translateY(-1px);
    border-color: rgba(0,0,0,.22);
    background-color: rgba(0,0,0,.02);
    box-shadow: 0 10px 24px rgba(0,0,0,.07);
  }

  .search-bar-container{
    position: relative;
    height: 44px;
    border-radius: 14px;
    border: 1px solid var(--line-2);
    background: var(--card);
    display:flex;
    align-items:center;
    padding: 0 12px;
    box-shadow: 0 2px 10px rgba(0,0,0,.04);
    min-width: 0;
  }

  .search-bar-container input[type="text"]{
    border: none;
    outline: none;
    width: 100%;
    height: 100%;
    font-size: 15px;
    font-weight: 600;
    background: transparent;
    color: var(--ink);
    padding-right: 28px;
  }

  .search-bar-container input::placeholder{
    color: rgba(0,0,0,.45);
    font-weight: 600;
  }

  .search-icon{
    position:absolute;
    right: 12px;
    top: 50%;
    transform: translateY(-50%);
    opacity: .55;
    pointer-events:none;
  }

  .sort-dropdown{ position: relative; }
  .sort-options{
    position:absolute;
    top: calc(100% + 8px);
    left: 0;
    width: 220px;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 14px;
    box-shadow: 0 18px 40px rgba(0,0,0,.12);
    padding: 6px;
    list-style:none;
    margin: 0;
    z-index: 50;
  }

  .sort-options li{
    padding: 10px 10px;
    border-radius: 12px;
    cursor:pointer;
    font-weight: 700;
    color: var(--ink);
  }

  .sort-options li:hover{ background: rgba(0,0,0,.04); }

  .filter-btn-icon:focus-visible,
  .sort-btn:focus-visible,
  .reset-cart-button:focus-visible,
  .cart-icon-button:focus-visible,
  .search-bar-container input:focus-visible,
  .open-button:focus-visible,
  .quantity-button:focus-visible,
  .filter-btn:focus-visible {
    outline: 2px solid rgba(0,0,0,.85);
    outline-offset: 2px;
  }

  /* Grid */
  .product-grid{
    display: flex;
    flex-direction: column;
    gap: 14px;
    max-width: 980px;
    margin: 0 auto;
  }

  .product-section{
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    overflow: hidden;
    transition: transform .18s ease, opacity .18s ease, filter .18s ease, box-shadow .18s ease, border-color .18s ease;
  }

  .product-section:hover{
    border-color: rgba(0,0,0,.16);
    box-shadow: 0 16px 34px rgba(0,0,0,.1);
  }

  .product-header{
    display:grid;
    grid-template-columns: 1fr auto;
    align-items:center;
    gap: 12px;
    padding: 14px 14px;
  }

  .product-title{
    font-size: 16px;
    font-weight: 900;
    letter-spacing: .1px;
    color: var(--ink);
    cursor: pointer;
    text-align: left;
    padding: 10px 8px;
    border-radius: 14px;
    transition: background-color .12s ease, transform .12s ease;
  }

  .product-title:hover{
    background: rgba(0,0,0,.03);
    transform: translateY(-1px);
  }

  .open-button{
    border: 1px solid var(--line-2);
    background: rgba(0,0,0,.03);
    border-radius: 999px;
    padding: 10px 14px;
    font-size: 13px;
    font-weight: 900;
    cursor:pointer;
    transition: transform .12s ease, background-color .12s ease, border-color .12s ease;
    white-space: nowrap;
  }

  .open-button:hover{
    transform: translateY(-1px);
    background: rgba(0,0,0,.05);
    border-color: rgba(0,0,0,.20);
  }

  /* Animated variants */
  .variant-list{
    padding: 0 14px 14px;
    display: grid;
    gap: 10px;
    overflow: hidden;
    height: 0;
    opacity: 0;
    transform: translateY(-4px);
    transition: height .24s ease, opacity .18s ease, transform .18s ease;
    will-change: height, opacity, transform;
  }

  .variant-list.is-open{
    opacity: 1;
    transform: translateY(0);
  }

  .variant-prompt{
    font-weight: 900;
    color: rgba(0,0,0,.72);
    margin-top: 2px;
    padding: 6px 10px;
    border-radius: 12px;
    background: rgba(0,0,0,.03);
    border: 1px solid rgba(0,0,0,.06);
  }

  .variant-row{
    display:grid;
    grid-template-columns: 1fr auto;
    align-items:center;
    gap: 12px;
    padding: 10px 10px;
    border-radius: 14px;
    border: 1px solid rgba(0,0,0,.06);
    background: rgba(0,0,0,.015);
    transition: border-color .14s ease, background-color .14s ease, transform .14s ease;
  }

  .variant-row:hover{
    border-color: rgba(0,0,0,.14);
    background: rgba(255,255,255,0.92);
    transform: translateY(-1px);
  }

  .variant-name{
    font-size: 14px;
    font-weight: 800;
    color: var(--ink);
  }

  .quantity-wrapper{
    display:inline-flex;
    align-items:center;
    border: 1px solid rgba(0,0,0,.14);
    background: #fff;
    border-radius: 999px;
    overflow:hidden;
    box-shadow: 0 6px 18px rgba(0,0,0,.06);
  }

  .quantity-button{
    background: rgba(0,0,0,.90);
    color: #fff;
    border: none;
    width: 36px;
    height: 36px;
    font-size: 16px;
    font-weight: 900;
    cursor:pointer;
    display:flex;
    align-items:center;
    justify-content:center;
    transition: transform .12s ease, background-color .12s ease;
  }

  .quantity-button:hover{ transform: translateY(-1px); background: rgba(0,0,0,.95); }
  .quantity-button:active{ transform: translateY(0px); }

  .quantity-display{
    min-width: 54px;
    text-align:center;
    padding: 0 10px;
    font-size: 16px;
    font-weight: 900;
    color: var(--ink);
  }

  /* Focus mode */
  .product-grid.is-focusing .product-section{
    opacity: .55;
    filter: saturate(.9);
  }

  .product-grid.is-focusing .product-section.is-focus{
    opacity: 1;
    filter: none;
    transform: translateY(-1px);
  }

  .mf-empty{
    text-align:center;
    margin-top: 22px;
    font-weight: 900;
    color: rgba(0,0,0,.55);
  }

  /* Responsive */
  @media (max-width: 980px){
    .mf-wl-layout.has-filters{ grid-template-columns: 1fr; }
    .mf-wl-layout.has-filters .collection-filter{ position: static; }

    .toolbar-shell{
      position: static;
      padding: 12px;
    }

    .toolbar-row{ grid-template-columns: 1fr 1fr; }
    .search-bar-container{ grid-column: 1 / -1; }
    .toolbar-left{ justify-content: space-between; }
    .reset-cart-wrapper, .toolbar-cart{ justify-content: flex-start; }
  }

  @media (max-width: 560px){
    .toolbar-row{ grid-template-columns: 1fr; }
    .product-header{ grid-template-columns: 1fr; }
    .open-button{ width: 100%; }
    .variant-row{ grid-template-columns: 1fr; }
    .quantity-wrapper{ width: 100%; justify-content: center; }
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce){
    .product-section,
    .product-title,
    .variant-list,
    .open-button,
    .quantity-button,
    .cart-icon-button,
    .filter-btn-icon,
    .sort-btn,
    .reset-cart-button{
      transition: none !important;
      animation: none !important;
    }
  }

.wholesale-line-sheet {
  --mf-ink: #28372e;
  --mf-paper: #e9ede3;
  --mf-card: #faf8f0;
  --mf-moss: #2f4838;
  --mf-amber: #9a6d35;
  --mf-rule: rgba(47, 72, 56, .22);
  --mf-muted: #596250;
  padding: 3.2rem 0 6rem;
  background: var(--mf-paper);
  color: var(--mf-ink);
  font-family: var(--font-body-family);
}
.wholesale-line-sheet .mf-wl-intro { display: flex; position: relative; flex-direction: column; justify-content: center; min-height: 20rem; padding-bottom: 3.2rem; isolation: isolate; background: var(--mf-paper); }
.wholesale-line-sheet .mf-wl-intro > div { max-width: 57%; }
.wholesale-line-sheet .mf-wl-intro__art { position: absolute; right: 3rem; bottom: 1rem; z-index: -1; width: 43%; height: 18rem; object-fit: contain; mix-blend-mode: multiply; pointer-events: none; }
.wholesale-line-sheet .mf-wl-eyebrow { margin: 0 0 .8rem; color: var(--mf-moss); font-size: 1rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; }
.wholesale-line-sheet .mf-wl-intro h1 { margin: 0; color: var(--mf-ink); font-family: var(--font-heading-family); font-size: clamp(3rem, 4vw, 4.4rem); font-weight: 400; line-height: 1.1; letter-spacing: -.04em; }
.wholesale-line-sheet .mf-wl-intro p:not(.mf-wl-eyebrow) { max-width: 70ch; margin: .8rem 0 0; color: var(--mf-muted); font-size: 1.4rem; line-height: 1.5; }
.wholesale-line-sheet .mf-wl-layout,
.wholesale-line-sheet .mf-wl-layout.has-filters { display: block; }
.wholesale-line-sheet .collection-filter,
.wholesale-line-sheet .mf-wl-layout.has-filters .collection-filter { display: block; position: static; margin: 0 0 1.6rem; padding: 0; border: 0; background: transparent; box-shadow: none; }
.wholesale-line-sheet .mf-filter-head { padding: 0; margin: 0 0 .8rem; border: 0; color: var(--mf-muted); font-size: 1.1rem; }
.wholesale-line-sheet .mf-filter-list { display: flex; flex-wrap: wrap; gap: .7rem; padding: 0; }
.wholesale-line-sheet .filter-btn { width: auto; min-height: 4rem; padding: .8rem 1.5rem; border: 1px solid var(--mf-rule); border-radius: 999px; background: #f7f7ef; color: var(--mf-ink); font-size: 1.2rem; font-weight: 600; }
.wholesale-line-sheet .filter-btn.active { background: var(--mf-moss); border-color: var(--mf-moss); color: #fff5e5; }
.wholesale-line-sheet .filter-btn.active::before { content: none; }
.wholesale-line-sheet .filter-btn:hover { transform: none; border-color: var(--mf-moss); }
.wholesale-line-sheet .toolbar-shell { position: sticky; top: calc(var(--header-height, 7rem) + 1rem); z-index: 10; margin: 0 0 1.6rem; padding: 1.4rem; border: 1px solid var(--mf-rule); border-radius: 20px; background: #faf8f0; box-shadow: 0 8px 24px rgba(35, 60, 49, .08); backdrop-filter: none; }
.wholesale-line-sheet .toolbar-row { display: grid; grid-template-columns: minmax(15rem, 1fr) auto minmax(18rem, 1.5fr) auto auto; gap: 1rem; }
.wholesale-line-sheet .mf-order-summary { display: grid; grid-template-columns: auto 1fr; align-items: baseline; gap: .3rem .8rem; }
.wholesale-line-sheet .mf-order-summary span { color: var(--mf-muted); font-size: 1rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
.wholesale-line-sheet .mf-order-summary strong { color: var(--mf-ink); font-size: 2.2rem; font-weight: 600; line-height: 1; }
.wholesale-line-sheet .mf-order-summary small { grid-column: 1 / -1; color: var(--mf-muted); font-size: 1.05rem; line-height: 1.4; }
.wholesale-line-sheet .cart-icon-button,
.wholesale-line-sheet .sort-btn,
.wholesale-line-sheet .reset-cart-button { min-height: 4.8rem; height: auto; padding: .8rem 1.4rem; border-color: var(--mf-rule); border-radius: 12px; background: var(--mf-card); color: var(--mf-ink); font-size: 1.15rem; font-weight: 600; box-shadow: none; }
.wholesale-line-sheet .cart-icon-button { flex-direction: column; gap: .2rem; background: var(--mf-moss); color: #fff5e5; border-color: var(--mf-moss); line-height: 1.2; }
.wholesale-line-sheet #cartCount { font-size: 1rem; }
.wholesale-line-sheet .filter-btn-icon { display: none; }
.wholesale-line-sheet .search-bar-container { min-height: 4.8rem; height: 4.8rem; border-color: var(--mf-rule); border-radius: 12px; background: #edf0e7; box-shadow: none; }
.wholesale-line-sheet .search-bar-container input[type='text'] { color: var(--mf-ink); font: inherit; font-size: 1.2rem; }
.wholesale-line-sheet .search-bar-container input::placeholder { color: #626958; }
.wholesale-line-sheet .toolbar-meta { margin: 1rem 0 0; color: var(--mf-muted); font-size: 1.05rem; font-weight: 400; }
