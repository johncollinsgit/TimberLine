  .wholesale-line-sheet .mf-quantity-cell { grid-column: 2; grid-row: 1 / span 2; align-self: center; }
  .wholesale-line-sheet .variant-row:first-child .mf-quantity-cell { grid-row: 2 / span 2; }
  .wholesale-line-sheet .mf-line-total { grid-column: 1 / -1; margin-top: .3rem; color: var(--mf-muted); font-size: 1rem; }
  .wholesale-line-sheet .mf-mobile-label { display: inline; }
  .wholesale-line-sheet .quantity-button { flex-basis: 4.8rem; width: 4.8rem; height: 4.8rem; }
  .wholesale-line-sheet input.quantity-display { height: 4.8rem; width: 4.4rem; }
}
@media (prefers-reduced-motion: reduce) {
  .wholesale-line-sheet * { animation: none !important; transition: none !important; }
}

</style>

<script>
  // ---------------- Match animation (6s) + embers + warm overlay ----------------
  document.addEventListener("DOMContentLoaded", () => {
    const matchWidgets = document.querySelectorAll(".wl-match");
    if (!matchWidgets.length) return;

    if (!document.querySelector(".wl-warm-overlay")) {
      const o = document.createElement("div");
      o.className = "wl-warm-overlay";
      o.setAttribute("aria-hidden", "true");
      document.body.appendChild(o);
    }

    function playFX() {
      try {
        const AudioCtx = window.AudioContext || window.webkitAudioContext;
        if (!AudioCtx) return;
        const ctx = new AudioCtx();
        const now = ctx.currentTime;

        const o1 = ctx.createOscillator();
        const o2 = ctx.createOscillator();
        const g  = ctx.createGain();
        o1.type = "triangle";
        o2.type = "square";
        o1.frequency.setValueAtTime(280, now);
        o2.frequency.setValueAtTime(540, now);
        g.gain.setValueAtTime(0.0001, now);
        g.gain.exponentialRampToValueAtTime(0.12, now + 0.02);
        g.gain.exponentialRampToValueAtTime(0.0001, now + 0.12);
        o1.connect(g); o2.connect(g); g.connect(ctx.destination);
        o1.start(now); o2.start(now);
        o1.stop(now + 0.13); o2.stop(now + 0.13);

        const o3 = ctx.createOscillator();
        const g3 = ctx.createGain();
        o3.type = "sine";
        o3.frequency.setValueAtTime(380, now + 0.18);
        o3.frequency.exponentialRampToValueAtTime(120, now + 0.65);
        g3.gain.setValueAtTime(0.0001, now + 0.18);
        g3.gain.exponentialRampToValueAtTime(0.06, now + 0.24);
        g3.gain.exponentialRampToValueAtTime(0.0001, now + 0.68);
        o3.connect(g3); g3.connect(ctx.destination);
        o3.start(now + 0.18);
        o3.stop(now + 0.7);

        setTimeout(() => ctx.close && ctx.close(), 900);
      } catch (e) {}
    }

    function startEmbers(canvas) {
      if (!canvas) return () => {};
      const ctx = canvas.getContext("2d");
      let raf = null;
      let running = true;

      function resize() {
        const r = canvas.getBoundingClientRect();
        canvas.width = Math.max(1, Math.floor(r.width * devicePixelRatio));
        canvas.height = Math.max(1, Math.floor(r.height * devicePixelRatio));
        ctx.setTransform(devicePixelRatio, 0, 0, devicePixelRatio, 0, 0);
      }

      const embers = [];
      function spawn() {
        const r = canvas.getBoundingClientRect();
        embers.push({
          x: r.width * 0.5 + (Math.random() - 0.5) * 50,
          y: 80 + Math.random() * 18,
          vx: (Math.random() - 0.5) * 0.4,
          vy: -0.8 - Math.random() * 1.1,
          life: 1.0,
          size: 1 + Math.random() * 2.2
        });
        if (embers.length > 90) embers.splice(0, embers.length - 90);
      }

      function tick() {
        if (!running) return;
        const r = canvas.getBoundingClientRect();
        ctx.clearRect(0, 0, r.width, r.height);

        if (Math.random() < 0.7) spawn();

        for (let i = embers.length - 1; i >= 0; i--) {
          const p = embers[i];
          p.x += p.vx;
          p.y += p.vy;
          p.vy -= 0.006;
          p.life -= 0.013;

          if (p.life <= 0 || p.y < -60) {
            embers.splice(i, 1);
            continue;
          }

          ctx.globalAlpha = Math.max(0, p.life);
          ctx.beginPath();
          ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
          ctx.fillStyle = "rgba(255,170,60,1)";
          ctx.fill();
        }

        ctx.globalAlpha = 1;
        raf = requestAnimationFrame(tick);
      }

      resize();
      window.addEventListener("resize", resize);
      raf = requestAnimationFrame(tick);

      return () => {
        running = false;
        if (raf) cancelAnimationFrame(raf);
        window.removeEventListener("resize", resize);
        ctx.clearRect(0, 0, canvas.width, canvas.height);
      };
    }

    matchWidgets.forEach((wrap) => {
      const btn  = wrap.querySelector(".wl-match__btn");
      const note = wrap.querySelector(".wl-match__note");
      const embersCanvas = wrap.querySelector(".wl-embers");
      if (!btn) return;

      const defaultNote = note ? (note.getAttribute("data-note-default") || note.textContent || "") : "";

      if (!wrap.querySelector(".wl-sparks")) {
        const s = document.createElement("div");
        s.className = "wl-sparks";
        s.setAttribute("aria-hidden", "true");
        wrap.appendChild(s);
      }
      const sparks = wrap.querySelector(".wl-sparks");

      function positionFX() {
        const match = btn.querySelector(".wl-match__match");
        const wrapRect = wrap.getBoundingClientRect();
        const btnRect  = btn.getBoundingClientRect();

        let x = (btnRect.left - wrapRect.left) + (btnRect.width * 0.36);
        let y = (btnRect.top  - wrapRect.top)  + (btnRect.height * 0.52);

        if (match) {
          const m = match.getBoundingClientRect();
          x = (m.right - wrapRect.left) - 6;
          y = (m.top - wrapRect.top) + (m.height / 2);
        }

        wrap.style.setProperty("--fx-x", `${x}px`);
        wrap.style.setProperty("--fx-y", `${y}px`);
        if (sparks) { sparks.style.left = `${x}px`; sparks.style.top = `${y}px`; }
      }

      let stopEmbers = null;
      let timers = [];

      function clearSeq() {
        timers.forEach(t => clearTimeout(t));
        timers = [];
        wrap.classList.remove("is-striking","is-burning","is-rising","is-embers","is-logo","is-lit");
        document.body.classList.remove("wl-warm");
        if (stopEmbers) { stopEmbers(); stopEmbers = null; }
        if (note) note.textContent = defaultNote || "";
      }

      function runSeq() {
        if (wrap.classList.contains("is-striking") || wrap.classList.contains("is-lit")) {
          clearSeq();
          return;
        }

        positionFX();
        playFX();

        wrap.classList.add("is-striking");
        if (note) note.textContent = "…shhk…";

        timers.push(setTimeout(() => {
          wrap.classList.remove("is-striking");
          wrap.classList.add("is-burning", "is-embers");
          if (note) note.textContent = "🔥";
          stopEmbers = startEmbers(embersCanvas);
        }, 1200));

        timers.push(setTimeout(() => {
          wrap.classList.add("is-rising");
          if (note) note.textContent = "…woah.";
        }, 1700));

        timers.push(setTimeout(() => {
          document.body.classList.add("wl-warm");
          wrap.classList.add("is-logo");
        }, 5000));

        timers.push(setTimeout(() => {
          document.body.classList.remove("wl-warm");
          wrap.classList.add("is-lit");
          wrap.classList.remove("is-rising");
          if (note) note.textContent = "You're Lit!";
        }, 6000));
      }

      btn.addEventListener("click", (e) => { e.preventDefault(); runSeq(); });

      let downX = null;
      btn.addEventListener("pointerdown", (e) => { downX = e.clientX; });
      btn.addEventListener("pointerup", (e) => {
        if (downX == null) return;
        const dx = e.clientX - downX;
        downX = null;
        if (dx > 22) runSeq();
      });

      window.addEventListener("resize", () => positionFX());
    });
  });

  // ---------------- Catalog logic (smooth, no full re-render on open/qty) ----------------
  (function(){
    const root = document.querySelector('[data-mf-wholesale]');
    if (!root) return;

    const jsonEl = document.getElementById("wholesale-products-json");
    if (!jsonEl) return;

    const grid = document.getElementById('productGrid');
    const noResults = document.getElementById("noResultsMessage");
    const input = document.getElementById("productSearchInput");
    const sortBtn = document.querySelector(".sort-btn");
    const sortMenu = document.querySelector(".sort-options");
    const filterToggle = document.querySelector(".filter-btn-icon");
    const layout = document.getElementById("mfWlLayout");

    const copy = {
      standard: {{ 'wholesale.line_sheet.standard' | t | json }},
      wholesale: {{ 'wholesale.line_sheet.wholesale' | t | json }},
      unavailable: {{ 'wholesale.line_sheet.unavailable' | t | json }},
      quantity: {{ 'wholesale.line_sheet.quantity' | t | json }},
      addThree: {{ 'wholesale.line_sheet.add_three' | t | json }},
      removeThree: {{ 'wholesale.line_sheet.remove_three' | t | json }},
      addOne: {{ 'wholesale.line_sheet.add_one' | t | json }},
      removeOne: {{ 'wholesale.line_sheet.remove_one' | t | json }},
      invalidQuantity: {{ 'wholesale.line_sheet.invalid_quantity' | t | json }},
      orderUpdated: {{ 'wholesale.line_sheet.order_updated' | t | json }},
      total: {{ 'wholesale.line_sheet.total' | t | json }}
    };

    const state = {
      products: [],
      sortMode: "az",
      searchQuery: "",
      filterSeason: "All",
      orderSelections: [],
      sectionByTitle: new Map(),
      qtyByVariantId: new Map(),
      busyVariants: new Set()
    };

    function money(n){
      const v = Number(n) || 0;
      return `$${v.toFixed(2)}`;
    }

    function normalizeTitle(t){ return String(t || "").trim(); }

    function setMessage(message, isError){
      const messageEl = document.getElementById('cartMessage');
      if (!messageEl) return;
      messageEl.textContent = message || '';
      messageEl.classList.toggle('is-error', Boolean(isError));
    }

    function updateCartDisplay(){
      const totalItems = state.orderSelections.reduce((sum, i) => sum + (Number(i.quantity) || 0), 0);
      const totalPrice = state.orderSelections.reduce((sum, i) => sum + ((Number(i.price) || 0) * (Number(i.quantity) || 0)), 0);

      const cartCountElem = document.getElementById('cartCount');
      if (cartCountElem) cartCountElem.textContent = `${totalItems} ${totalItems === 1 ? 'item' : 'items'}`;

      const totalEl = document.getElementById('cartTotal');
      if (totalEl) totalEl.textContent = money(totalPrice);

      const progressEl = document.getElementById('cartProgress');
      if (progressEl) {
        const remaining = Math.max(0, 150 - totalPrice);
        progressEl.textContent = remaining > 0
          ? `Add ${money(remaining)} to reach the order minimum.`
          : 'Order minimum reached. Review your order when ready.';
      }

      const cartSummary = document.getElementById('cartSummary');
      if (cartSummary) {
        cartSummary.innerHTML = `Review order <span id="cartCount">${totalItems} ${totalItems === 1 ? 'item' : 'items'}</span>`;
      }
    }

    function renderCartState(){
      state.qtyByVariantId.clear();
      state.orderSelections.forEach((item) => state.qtyByVariantId.set(Number(item.variantId), (state.qtyByVariantId.get(Number(item.variantId)) || 0) + (Number(item.quantity) || 0)));

      state.sectionByTitle.forEach((section) => {
        section.querySelectorAll('[data-variant-id]').forEach((row) => {
          const variantId = Number(row.getAttribute('data-variant-id'));
          const display = row.querySelector('.quantity-display');
          const quantity = state.qtyByVariantId.get(variantId) || 0;
          if (display) display.value = String(quantity);
          const selection = state.orderSelections.find((item) => Number(item.variantId) === variantId);
          const total = row.querySelector('.mf-line-total-value');
          if (total) total.textContent = quantity ? money(quantity * Number(selection?.price || 0)) : '—';
        });
        updateHeaderCount(section);
      });
      updateCartDisplay();
    }

    document.addEventListener('mf:cart-changed', (event) => syncCart(event.detail));

    function syncCart(cart){
      state.orderSelections = (cart.items || []).map(item => ({
        product: item.product_title,
        variantId: item.variant_id,
        lineKey: item.key,
        name: item.variant_title,
        price: item.final_price / 100,
        quantity: item.quantity,
        properties: { ...(item.properties || {}) }
      }));
      renderCartState();
    }

    function setOptimisticQuantity(productTitle, variantId, quantity){
      const vid = Number(variantId);
      const itemIndex = state.orderSelections.findIndex((item) => Number(item.variantId) === vid);

      if (quantity <= 0) {
        if (itemIndex >= 0) state.orderSelections.splice(itemIndex, 1);
        renderCartState();
        return;
      }

      if (itemIndex >= 0) {
        state.orderSelections[itemIndex].quantity = quantity;
        renderCartState();
        return;
      }

      const product = state.products.find((item) => item.title === productTitle);
      const variant = product?.variants?.find((item) => Number(item.id) === vid);
      if (!variant) return;

      state.orderSelections.push({
        product: productTitle,
        variantId: vid,
        lineKey: null,
        name: variant.name,
        price: Number(variant.price) || 0,
        quantity
      });
      renderCartState();
    }

    function renderCartSections(sections){
      if (!sections) return;

      const bubbleMarkup = sections['cart-icon-bubble'];
      const bubble = document.getElementById('cart-icon-bubble');
      if (bubbleMarkup && bubble) {
        const freshBubble = new DOMParser().parseFromString(bubbleMarkup, 'text/html').getElementById('cart-icon-bubble');
        if (freshBubble) bubble.replaceWith(freshBubble);
      }

      const drawerMarkup = sections['cart-drawer'];
      const drawer = document.querySelector('cart-drawer');
      const drawerContent = drawer?.querySelector('#CartDrawer');
      if (drawerMarkup && drawerContent) {
        const freshDrawer = new DOMParser().parseFromString(drawerMarkup, 'text/html').querySelector('#CartDrawer');
        if (freshDrawer) drawerContent.innerHTML = freshDrawer.innerHTML;
      }
      if (drawer) drawer.classList.toggle('is-empty', state.orderSelections.length === 0);

      if (drawer?.setHeaderCartIconAccessibility) drawer.setHeaderCartIconAccessibility();
    }

    async function refreshCart() {
      const response = await fetch('/cart.js', { headers: { Accept: 'application/json' } });
      if (!response.ok) throw new Error('We could not load your order. Please refresh and try again.');
      const cart = await response.json();
      syncCart(cart);
      return cart;
    }

    window.resetWholesaleCart = function resetWholesaleCart() {
      setMessage('Clearing your order…');
      fetch('/cart/clear.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({ sections: ['cart-icon-bubble', 'cart-drawer'] })
      })
        .then((response) => {
          if (!response.ok) throw new Error('We could not clear your order.');
          return response.json();
        })
        .then((cart) => {
          syncCart(cart);
          renderCartSections(cart.sections);
          setMessage('Your order is clear.');
        })
        .catch((error) => setMessage(error.message, true));
    }

    function updateHeaderCount(sec){
      const title = sec.dataset.productTitle;
      const items = state.orderSelections.filter(o => o.product === title && (Number(o.quantity) || 0) > 0);
      const units = items.reduce((total, item) => total + (Number(item.quantity) || 0), 0);

      const titleEl = sec.querySelector('.product-title');
      if (titleEl) {
        titleEl.textContent = title.replace(/^wholesale\s+/i, '');
      }

      const orderState = sec.querySelector('.mf-product-order-state');
      if (orderState) {
        orderState.textContent = units > 0
          ? `${units} ${units === 1 ? 'unit' : 'units'} in your order`
          : '';
      }
    }

    function setVariantListOpen(sec, open){
      const vl = sec.querySelector('.variant-list');
      if (!vl) return;

      if (open) {
        vl.classList.add('is-open');
        vl.style.height = 'auto';
        const h = vl.scrollHeight;
        vl.style.height = '0px';
        requestAnimationFrame(() => {
          vl.style.height = h + 'px';
          setTimeout(() => { vl.style.height = 'auto'; }, 260);
        });
        sec.classList.add('is-open');
      } else {
        const cur = vl.scrollHeight;
        vl.style.height = cur + 'px';
        requestAnimationFrame(() => {
          vl.style.height = '0px';
          vl.classList.remove('is-open');
        });
        sec.classList.remove('is-open');
      }
    }

    function setFocus(titleOrNull){
      // Cards can be opened independently. Search and sort must never hide an
      // in-progress order or dim the rest of the catalog.
      void titleOrNull;
    }

    function passesFilters(product){
      const searchable = [
        product.title,
        product.handle,
        ...(product.variants || []).map((variant) => `${variant.name || ''} ${variant.sku || ''}`)
      ].join(' ').toLowerCase();
      if (state.searchQuery && !searchable.includes(state.searchQuery)) return false;
      if (state.filterSeason && state.filterSeason !== "All" && product.season !== state.filterSeason) return false;
      return true;
    }

    function applyVisibility(){
      let visibleCount = 0;

      state.products.forEach((p) => {
        const sec = state.sectionByTitle.get(p.title);
        if (!sec) return;
        const show = passesFilters(p);
        sec.hidden = !show;
        if (show) visibleCount++;
      });

      if (noResults) noResults.style.display = visibleCount === 0 ? 'block' : 'none';
    }

    function sortProducts(){
      const list = [...state.products];
      if (state.sortMode === "newest") list.sort((a,b) => (b.handle || "").localeCompare(a.handle || ""));
      else if (state.sortMode === "za") list.sort((a,b) => (b.title || "").localeCompare(a.title || ""));
      else list.sort((a,b) => (a.title || "").localeCompare(b.title || ""));

      const frag = document.createDocumentFragment();
      list.forEach((p) => {
        const sec = state.sectionByTitle.get(p.title);
        if (sec) frag.appendChild(sec);
      });
      grid.appendChild(frag);
      state.products = list;
    }

    function nextPackQuantity(currentQuantity, direction, increment = 3){
      const current = Math.max(0, Number(currentQuantity) || 0);
      if (direction > 0) return Math.max(increment, Math.ceil((current + 1) / increment) * increment);
      return Math.max(0, Math.floor((current - 1) / increment) * increment);
    }

    function setVariantBusy(variantId, isBusy){
      const selector = `[data-variant-id="${Number(variantId)}"] :is(.quantity-button, .quantity-display)`;
      document.querySelectorAll(selector).forEach((button) => { button.disabled = isBusy; });
    }

    function variantIncrement(id){return Number(state.products.flatMap(p=>p.variants).find(v=>Number(v.id)===Number(id))?.increment)||3;}

    function adjustQuantity(productTitle, variantId, delta){
      const current = state.qtyByVariantId.get(Number(variantId)) || 0;
      return commitQuantity(productTitle, variantId, nextPackQuantity(current, delta, variantIncrement(variantId)));
    }

    async function commitQuantity(productTitle, variantId, quantity){
      const vid = Number(variantId);
      const title = normalizeTitle(productTitle);
      if (state.busyVariants.has(vid)) return;

      const existing = state.orderSelections.find((item) => Number(item.variantId) === vid);
      const duplicates = state.orderSelections.filter((item) => Number(item.variantId) === vid);
      if (duplicates.length > 1) { setMessage({{ 'wholesale.labels.manage_in_cart' | t | json }}, true); return; }
      const currentQty = Number(existing?.quantity) || 0;
      const newQty = Number(quantity);
      if (!Number.isInteger(newQty) || newQty < 0 || newQty % variantIncrement(vid) !== 0) {
        renderCartState();
        setMessage(copy.invalidQuantity, true);
        return;
      }
      if (newQty === currentQty) return;
      const previousSelections = state.orderSelections.map((item) => ({ ...item }));

      state.busyVariants.add(vid);
      setVariantBusy(vid, true);
      setOptimisticQuantity(title, vid, newQty);
      setMessage(copy.orderUpdated);

      try {
        const endpoint = currentQty === 0 && newQty > 0 ? '/cart/add.js' : '/cart/change.js';
        const body = currentQty === 0 && newQty > 0
          ? { items: [{ id: vid, quantity: newQty }], sections: ['cart-icon-bubble', 'cart-drawer'] }
          : { id: existing?.lineKey || vid, quantity: newQty, sections: ['cart-icon-bubble', 'cart-drawer'] };
        const response = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(body)
        });

        if (!response.ok) {
          const payload = await response.json().catch(() => ({}));
          throw new Error(payload.description || payload.message || 'We could not update your order.');
        }

        const payload = await response.json();
        if (Array.isArray(payload.items) && payload.item_count !== undefined) {
          syncCart(payload);
        } else if (Array.isArray(payload.items)) {
          payload.items.forEach((item) => {
            const selection = state.orderSelections.find((entry) => Number(entry.variantId) === Number(item.variant_id));
            if (!selection) return;
            selection.lineKey = item.key;
            selection.price = Number(item.final_price) / 100;
            selection.quantity = Number(item.quantity) || selection.quantity;
          });
          renderCartState();
        }
        renderCartSections(payload.sections);
        if (typeof publish === 'function' && typeof PUB_SUB_EVENTS !== 'undefined') {
          publish(PUB_SUB_EVENTS.cartUpdate, { source: 'mf-wholesale-line-sheet', cartData: payload });
        }
      } catch (error) {
        state.orderSelections = previousSelections;
        renderCartState();
        setMessage(error.message || 'We could not update your order. Please try again.', true);
      } finally {
        state.busyVariants.delete(vid);
        setVariantBusy(vid, false);
      }
    }

    function buildSection(product){
      const sec = document.createElement('tbody');
      const labelService = !!window.MFCustomLabels && ['custom-label-set-up', 'use-my-custom-label'].includes(product.handle);
      if (labelService) sec.dataset.mfLabelProduct = product.handle;
      sec.className = 'product-section';
      sec.id = product.handle || '';
      sec.dataset.season = product.season || 'Uncategorized';
      sec.dataset.productTitle = product.title;
      const variants = product.variants || [];
      variants.forEach((variant, index) => {
        const row = document.createElement('tr');
        row.className = 'variant-row';
        row.setAttribute('data-variant-id', String(variant.id));
        if (index === 0) {
          const cell = document.createElement('td');
          cell.className = 'product-cell';
          cell.rowSpan = variants.length;
          const heading = document.createElement('div');
          heading.className = 'mf-product-heading';
          const image = document.createElement(product.image ? 'img' : 'div');
          image.className = product.image ? 'mf-product-image' : 'mf-product-image--placeholder';
          if (product.image) {
            image.src = product.image;
            image.alt = '';
            image.width = 64;
            image.height = 64;
            image.loading = 'lazy';
          } else {
            image.setAttribute('aria-hidden', 'true');
            image.textContent = '✦';
          }
          const content = document.createElement('div');
          const meta = document.createElement('div');
          meta.className = 'mf-product-meta';
          meta.textContent = product.season === 'Uncategorized' ? copy.wholesale : product.season;
          const title = document.createElement('h2');
          title.className = 'product-title';
          title.textContent = product.title.replace(/^wholesale\s+/i, '');
          const order = document.createElement('span');
          order.className = 'mf-product-order-state';
          content.append(meta, title, order);
          heading.append(image, content);
          cell.appendChild(heading);
          row.appendChild(cell);
        }
        const size = document.createElement('td');
        size.className = 'mf-size-cell';
        const name = document.createElement('span');
        name.className = 'variant-name';
        name.textContent = variant.name === 'Default Title' ? copy.standard : variant.name;
        size.appendChild(name);
        if (variant.sku) {
          const sku = document.createElement('span');
          sku.className = 'variant-detail';
          sku.textContent = variant.sku;
          size.appendChild(sku);
        }
        const price = document.createElement('td');
        price.className = 'mf-unit-price';
        price.textContent = money(variant.price);
        const quantityCell = document.createElement('td');
        quantityCell.className = 'mf-quantity-cell';
        const wrapper = document.createElement('div');
        wrapper.className = 'quantity-wrapper';
        const minus = document.createElement('button');
        minus.className = 'quantity-button';
        minus.type = 'button';
        minus.textContent = '−';
        minus.setAttribute('aria-label', `${Number(variant.increment)===1?copy.removeOne:copy.removeThree}: ${product.title}, ${variant.name}`);
        minus.addEventListener('click', () => adjustQuantity(product.title, variant.id, -1));
        const input = document.createElement('input');
        input.className = 'quantity-display';
        input.type = 'number';
        input.min = '0';
        const increment = Number(variant.increment)||3;
        input.step = String(increment);
        input.inputMode = 'numeric';
        input.value = String(state.qtyByVariantId.get(Number(variant.id)) || 0);
        input.setAttribute('aria-label', `${copy.quantity}: ${product.title}, ${variant.name}`);
        input.addEventListener('change', () => {
          const quantity = Number(input.value);
          if (!Number.isInteger(quantity) || quantity < 0 || quantity % increment !== 0) {
            input.setCustomValidity(copy.invalidQuantity);
            input.reportValidity();
            input.setCustomValidity('');
            renderCartState();
            setMessage(copy.invalidQuantity, true);
            return;
          }
          commitQuantity(product.title, variant.id, quantity);
        });
        input.addEventListener('keydown', (event) => {
          if (event.key === 'Enter') { event.preventDefault(); input.blur(); }
        });
        const plus = document.createElement('button');
        plus.className = 'quantity-button';
        plus.type = 'button';
        plus.textContent = '+';
        plus.setAttribute('aria-label', `${Number(variant.increment)===1?copy.addOne:copy.addThree}: ${product.title}, ${variant.name}`);
        plus.addEventListener('click', () => adjustQuantity(product.title, variant.id, 1));
        wrapper.append(minus, input, plus);
        quantityCell.appendChild(wrapper);
        if (labelService) {
          const entry = document.createElement('div'); entry.className = 'mf-label-entry';
          const button = document.createElement('button'); button.type = 'button'; button.className = 'button button--secondary';
          button.dataset.mfLabelOpen = product.handle === 'custom-label-set-up' ? 'new' : 'reuse';
          button.textContent = product.handle === 'custom-label-set-up' ? {{ 'wholesale.labels.setup_action' | t | json }} : {{ 'wholesale.labels.reuse_action' | t | json }};
          entry.append(button); quantityCell.append(entry);
        }

        if (!variant.available) {
          row.classList.add('is-unavailable');
          minus.disabled = input.disabled = plus.disabled = true;
          const unavailable = document.createElement('span');
          unavailable.className = 'variant-detail';
          unavailable.textContent = copy.unavailable;
          quantityCell.appendChild(unavailable);
        }
        const total = document.createElement('td');
        total.className = 'mf-line-total';
        const label = document.createElement('span');
        label.className = 'mf-mobile-label';
        label.textContent = `${copy.total}: `;
        const value = document.createElement('span');
        value.className = 'mf-line-total-value';
        value.textContent = '—';
        total.append(label, value);
        row.append(size, price, quantityCell, total);
        sec.appendChild(row);
      });
      updateHeaderCount(sec);
      return sec;
    }

    function closeDropdown(){
      if (!sortMenu || !sortBtn) return;
      sortMenu.style.display = "none";
      sortBtn.setAttribute("aria-expanded","false");
    }

    function openDropdown(){
      if (!sortMenu || !sortBtn) return;
      sortMenu.style.display = "block";
      sortBtn.setAttribute("aria-expanded","true");
    }

    function init(){
      state.products = JSON.parse(jsonEl.textContent || "[]");

      const frag = document.createDocumentFragment();
      state.sectionByTitle.clear();
      state.products.forEach((product) => {
        const section = buildSection(product);
        state.sectionByTitle.set(product.title, section);
        frag.appendChild(section);
      });
      grid.querySelectorAll('tbody').forEach((body) => body.remove());
      grid.appendChild(frag);
      sortProducts();
      applyVisibility();

      refreshCart().catch((error) => setMessage(error.message, true));

      // Search
      if (input) {
        input.addEventListener("input", (e) => {
          state.searchQuery = String(e.target.value || "").toLowerCase().trim();
          setFocus(null);
          applyVisibility();
        });

        input.addEventListener("keydown", (e) => {
          if (e.key === "Enter") { e.preventDefault(); e.target.blur(); }
        });
      }

      // Sort
      if (sortBtn) {
        sortBtn.addEventListener("click", () => {
          if (!sortMenu) return;
          const open = sortMenu.style.display === "block";
          if (open) closeDropdown();
          else openDropdown();
        });
      }

      if (sortMenu) {
        sortMenu.querySelectorAll("li").forEach((opt) => {
          opt.addEventListener("click", () => {
            state.sortMode = opt.dataset.sort || "az";
            closeDropdown();
            setFocus(null);
            sortProducts();
            applyVisibility();
          });
        });
      }

      document.addEventListener("click", (e) => {
        if (!sortMenu || !sortBtn) return;
        const inDrop = sortMenu.contains(e.target) || sortBtn.contains(e.target);
        if (!inDrop) closeDropdown();
      });

      // FILTER TOGGLE — FIXED (no inline display changes)
      if (filterToggle && layout) {
        filterToggle.addEventListener("click", () => {
          layout.classList.toggle("has-filters");
        });
      }

      // Filters
      document.querySelectorAll(".filter-btn").forEach((btn) => {
        btn.addEventListener("click", () => {
          document.querySelectorAll(".filter-btn").forEach(b => b.classList.remove("active"));
          btn.classList.add("active");
          state.filterSeason = btn.dataset.collection || "All";
          setFocus(null);
          applyVisibility();
        });
      });
    }

    init();
  })();
</script>
