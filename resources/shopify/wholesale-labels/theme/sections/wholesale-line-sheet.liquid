.wholesale-line-sheet .mf-col-size { width: 22%; }
.wholesale-line-sheet .mf-col-price { width: 12%; }
.wholesale-line-sheet .mf-col-quantity { width: 22%; }
.wholesale-line-sheet .mf-col-total { width: 12%; }
.wholesale-line-sheet .product-section { display: table-row-group; background: var(--mf-card); border: 0; border-radius: 0; box-shadow: none; }
.wholesale-line-sheet .product-section[hidden] { display: none; }
.wholesale-line-sheet .product-section:nth-of-type(even) { background: #eef1e8; }
.wholesale-line-sheet .product-section:hover { box-shadow: none; transform: none; }
.wholesale-line-sheet .product-section + .product-section { border-top: 1px solid var(--mf-rule); }
.wholesale-line-sheet .product-grid td { padding: 1.2rem 1.6rem; vertical-align: middle; font-size: 1.4rem; }
.wholesale-line-sheet .product-grid .product-cell { vertical-align: top; }
.wholesale-line-sheet .mf-product-heading { display: flex; align-items: flex-start; gap: 1.2rem; padding-top: .3rem; }
.wholesale-line-sheet .mf-product-image,
.wholesale-line-sheet .mf-product-image--placeholder { flex: 0 0 6.4rem; width: 6.4rem; height: 6.4rem; min-height: 0; border-radius: 12px; object-fit: cover; background: #e4dac9; }
.wholesale-line-sheet .mf-product-image--placeholder { display: grid; place-items: center; }
.wholesale-line-sheet .mf-product-meta { color: var(--mf-muted); font-size: .85rem; font-weight: 600; letter-spacing: .07em; text-transform: uppercase; }
.wholesale-line-sheet .product-title { margin: .35rem 0 .6rem; padding: 0; color: var(--mf-ink); font-family: var(--font-body-family); font-size: 1.6rem; font-weight: 650; letter-spacing: -.02em; line-height: 1.35; cursor: default; }
.wholesale-line-sheet .product-title:hover { transform: none; background: transparent; }
.wholesale-line-sheet .mf-product-order-state { display: block; color: var(--mf-moss); font-size: 1rem; line-height: 1.4; }
.wholesale-line-sheet .variant-row + .variant-row > td { border-top: 1px solid rgba(47, 72, 56, .08); }
.wholesale-line-sheet .variant-row { display: table-row; border: 0; border-radius: 0; background: transparent; }
.wholesale-line-sheet .variant-row:hover { transform: none; background: rgba(112, 137, 100, .08); }
.wholesale-line-sheet .variant-name { color: var(--mf-ink); font-size: 1.35rem; font-weight: 500; }
.wholesale-line-sheet .variant-detail { display: block; margin-top: .4rem; color: var(--mf-muted); font-size: .95rem; }
.wholesale-line-sheet .quantity-wrapper { display: inline-flex; width: auto; justify-content: flex-start; border: 1px solid var(--mf-moss); border-radius: 12px; background: #fffdf7; box-shadow: none; }
.wholesale-line-sheet .quantity-button { flex: 0 0 4rem; width: 4rem; height: 4.4rem; background: #2f4838; color: #faf8f0; border: 0; font-size: 1.5rem; font-weight: 700; }
.wholesale-line-sheet .quantity-button:hover { background: #426148; transform: none; }
.wholesale-line-sheet input.quantity-display { display: block; width: 4.6rem; min-width: 0; height: 4.4rem; padding: 0; border: 0; border-radius: 0; background: transparent; color: var(--mf-ink); font: inherit; font-size: 1.25rem; font-weight: 600; text-align: center; appearance: textfield; }
.wholesale-line-sheet input.quantity-display::-webkit-inner-spin-button,
.wholesale-line-sheet input.quantity-display::-webkit-outer-spin-button { appearance: none; margin: 0; }
.wholesale-line-sheet .quantity-button:disabled,
.wholesale-line-sheet .quantity-display:disabled { cursor: wait; opacity: .5; }
.wholesale-line-sheet .variant-row.is-unavailable .quantity-wrapper { display: none; }
.wholesale-line-sheet .mf-line-total,
.wholesale-line-sheet .mf-unit-price { font-variant-numeric: tabular-nums; white-space: nowrap; }
.wholesale-line-sheet .mf-mobile-label { display: none; }
.wholesale-line-sheet .mf-empty { color: var(--mf-muted); font-size: 1.4rem; }
.wholesale-line-sheet :is(button, input, a):focus-visible { outline: 2px solid #8b6536; outline-offset: 3px; }
@media (max-width: 1050px) {
  .wholesale-line-sheet .toolbar-row { grid-template-columns: auto minmax(14rem, 1fr) auto auto; }
  .wholesale-line-sheet .mf-order-summary { grid-column: 1 / -1; }
  .wholesale-line-sheet .product-grid td,
  .wholesale-line-sheet .product-grid th { padding-inline: 1rem; }
  .wholesale-line-sheet .mf-col-product { width: 30%; }
  .wholesale-line-sheet .mf-col-size { width: 22%; }
  .wholesale-line-sheet .mf-col-price { width: 12%; }
  .wholesale-line-sheet .mf-col-quantity { width: 24%; }
  .wholesale-line-sheet .mf-col-total { width: 12%; }
  .wholesale-line-sheet .mf-product-image { display: none; }
}
@media (max-width: 749px) {
  .wholesale-line-sheet { padding-top: 2rem; }
  .wholesale-line-sheet .mf-wl-intro { min-height: 0; padding-bottom: 1.6rem; }
  .wholesale-line-sheet .mf-wl-intro > div { max-width: none; }
