  .wholesale-line-sheet .product-section { padding: 1.6rem; }
  .wholesale-line-sheet .variant-row { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: .6rem 1rem; padding: 1.4rem 0; }
  .wholesale-line-sheet .product-grid td { display: block; padding: 0; border: 0; }
  .wholesale-line-sheet .product-cell { grid-column: 1 / -1; margin-bottom: .6rem; }
