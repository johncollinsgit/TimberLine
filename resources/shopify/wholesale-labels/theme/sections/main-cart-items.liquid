{{ 'component-cart.css' | asset_url | stylesheet_tag }}
{{ 'component-cart-items.css' | asset_url | stylesheet_tag }}
{{ 'component-totals.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-discounts.css' | asset_url | stylesheet_tag }}
{{ 'quantity-popover.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  /* Modern Forestry — ultra-simple cart rows */
  .mf-tagrow {
    margin-top: .35rem;
    display: flex;
    flex-wrap: wrap;
    gap: .35rem;
    align-items: center;
  }
  .mf-chip {
    display: inline-flex;
    align-items: center;
    padding: .18rem .55rem;
    border-radius: 999px;
    font-size: .78rem;
    font-weight: 800;
    letter-spacing: .2px;
    color: rgb(var(--color-foreground));
    background: rgb(var(--color-foreground) / 0.06);
    border: 1px solid rgb(var(--color-foreground) / 0.14);
    white-space: nowrap;
  }

  .mf-line-total {
    font-weight: 800;
    font-size: 1rem;
    letter-spacing: .2px;
    color: rgb(var(--color-foreground));
  }
  .mf-line-compare {
    display: block;
    margin-top: .15rem;
    font-size: .85rem;
    color: rgb(var(--color-foreground) / 0.62);
  }

  .mf-unitprice-row dt { opacity: .75; }
.mf-unitprice-row dd { font-weight: 800; }
  .mf-unitprice-compare {
  margin-left: .4rem;
  font-weight: 700;
  opacity: .65;
}

  /* Modern Forestry — compact cart */

  .mf-cart-title-row {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1.2rem;
  }

  .mf-cart-header-note {
    margin: 0;
    text-align: center;
    font-size: 1.3rem;
    line-height: 1.4;
    color: rgba(var(--color-foreground), 0.78);
    max-width: 60rem;
    justify-self: center;
  }

  /* tighten layout a touch on desktop */
  @media (min-width: 990px) {
    .cart-item__details { padding-right: 1rem; }
    .cart-item__totals.right { width: 1%; white-space: nowrap; }
  }

  @media screen and (max-width: 749px) {
    .mf-cart-title-row {
      grid-template-columns: 1fr auto;
      row-gap: 0.8rem;
    }

    .mf-cart-header-note {
      grid-column: 1 / -1;
      order: 3;
      font-size: 1.2rem;
    }

    .cart-item {
      margin-bottom: 2.2rem;
      padding-bottom: 2.2rem;
      border-bottom: 0.1rem solid rgba(var(--color-foreground), 0.08);
    }

    .cart-item:last-child {
      margin-bottom: 0;
      padding-bottom: 0;
      border-bottom: 0;
    }

    .cart-item__details {
      font-size: 1.45rem;
      line-height: 1.45;
    }

    .cart-item__name {
      font-size: 1.5rem;
      line-height: 1.3;
    }

    .cart-item__media {
      width: 7rem;
    }

    .cart-item__image {
      max-width: 7rem;
    }
  }

  @media screen and (min-width: 750px) {
    .cart-items td {
      padding-top: 1.8rem;
      padding-bottom: 1.8rem;
    }

    .cart-item td {
      border-bottom: 0.1rem solid rgba(var(--color-foreground), 0.08);
    }

    .cart-item:last-child td {
      border-bottom: 0;
    }

    .cart-item__details {
      font-size: 1.5rem;
      line-height: 1.45;
    }

    .cart-item__name {
      font-size: 1.8rem;
      line-height: 1.3;
      font-weight: 600;
    }

    .cart-item__media {
      width: 8.2rem;
    }

    .cart-item__image {
      max-width: 8.2rem;
    }

    .product-option {
      font-size: 1.3rem;
      color: rgba(var(--color-foreground), 0.78);
    }

    .cart-item__details > * + * {
      margin-top: 0.35rem;
    }

    .cart-item__image-container {
      border-radius: 1rem;
      overflow: hidden;
      background: rgba(var(--color-foreground), 0.04);
    }

    .cart-item__quantity-wrapper {
      gap: 0.6rem;
      align-items: center;
    }
  }
{%- endstyle -%}

{%- unless settings.cart_type == 'drawer' -%}
  <script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>
{%- endunless -%}
<script src="{{ 'quantity-popover.js' | asset_url }}" defer="defer"></script>

<cart-items class="gradient color-{{ section.settings.color_scheme }} isolate{% if cart == empty %} is-empty{% else %} section-{{ section.id }}-padding{% endif %}">
  <div class="page-width">
    <div class="title-wrapper-with-link mf-cart-title-row">
      <h1 class="title title--primary">{{ 'sections.cart.title' | t }}</h1>
      <p class="mf-cart-header-note">Thank you for supporting small business.</p>
      <a href="{{ routes.all_products_collection_url }}" class="underlined-link">
        {{- 'general.continue_shopping' | t -}}
      </a>
    </div>

    <div class="cart__warnings">
      <h1 class="cart__empty-text">{{ 'sections.cart.empty' | t }}</h1>
      <a href="{{ routes.all_products_collection_url }}" class="button">
        {{ 'general.continue_shopping' | t }}
      </a>

      {%- if shop.customer_accounts_enabled and customer == null -%}
        <h2 class="cart__login-title">{{ 'sections.cart.login.title' | t }}</h2>
        <p class="cart__login-paragraph">
          {{ 'sections.cart.login.paragraph_html' | t: link: routes.account_login_url }}
        </p>
      {%- endif -%}
    </div>

    <form action="{{ routes.cart_url }}" class="cart__contents critical-hidden" method="post" id="cart">
      <div class="cart__items" id="main-cart-items" data-id="{{ section.id }}">
        <div class="js-contents">
          {%- if cart != empty -%}
            {%- liquid
              assign mf_min_cents = 15000
              assign mf_discount_active = false
              if cart.total_price < cart.original_total_price
                assign mf_discount_active = true
              endif
              assign mf_remaining = mf_min_cents | minus: cart.total_price
            -%}

            <table class="cart-items">
              <caption class="visually-hidden">{{ 'sections.cart.title' | t }}</caption>
              <thead>
                <tr>
                  <th class="caption-with-letter-spacing" colspan="2" scope="col">
                    {{ 'sections.cart.headings.product' | t }}
                  </th>
                  <th class="medium-hide large-up-hide right caption-with-letter-spacing" scope="col">
                    {{ 'sections.cart.headings.total' | t }}
                  </th>
                  <th class="cart-items__heading--wide cart-items__heading--quantity small-hide caption-with-letter-spacing" scope="col">
                    {{ 'sections.cart.headings.quantity' | t }}
                  </th>
                  <th class="small-hide right caption-with-letter-spacing" scope="col">
                    {{ 'sections.cart.headings.total' | t }}
                  </th>
                </tr>
              </thead>

              <tbody>
                {%- for item in cart.items -%}
                {%- liquid
                  assign mf_line_paid_cents = item.final_line_price
                  assign mf_line_retail_cents = item.original_line_price
                  assign mf_has_compare = false
                  if mf_discount_active and mf_line_retail_cents > mf_line_paid_cents
                    assign mf_has_compare = true
                  endif

                -%}

                  {%- capture mf_order_increment -%}{%- render 'mf-order-increment', product: item.product, variant: item.variant -%}{%- endcapture -%}
                  {%- assign mf_single_qty = false -%}{%- if mf_order_increment == '1' -%}{%- assign mf_single_qty = true -%}{%- endif -%}
                  <tr
                    class="cart-item"
                    id="CartItem-{{ item.key }}"
                    data-line-item-key="{{ item.key }}"
                    data-variant-id="{{ item.variant.id }}"
                    data-properties='{{ item.properties | json | escape }}'
                  >
                    <td class="cart-item__media">
                      {%- if item.image -%}
                        <a href="{{ item.url }}" class="cart-item__link" aria-hidden="true" tabindex="-1"> </a>
                        <div class="cart-item__image-container gradient global-media-settings">
                          <img
                            src="{{ item.image | image_url: width: 300 }}"
                            class="cart-item__image"
                            alt="{{ item.image.alt | escape }}"
                            loading="lazy"
                            width="150"
                            height="{{ 150 | divided_by: item.image.aspect_ratio | ceil }}"
                          >
                        </div>
                      {%- endif -%}
                    </td>

                    <td class="cart-item__details">
                      {%- if settings.show_vendor -%}
                        <p class="caption-with-letter-spacing">{{ item.product.vendor }}</p>
                      {%- endif -%}

                      <a href="{{ item.url }}" class="cart-item__name h4 break">{{ item.product.title | escape }}</a>

                      {%- if item.product.has_only_default_variant == false
                        or item.properties.size != 0
                        or item.selling_plan_allocation != null
                      -%}
                        <dl>
                          {%- if item.product.has_only_default_variant == false -%}
{%- for option in item.options_with_values -%}
  <div class="product-option">
    <dt>{{ option.name }}:</dt>
    <dd>{{ option.value }}</dd>
  </div>

  {%- assign opt_name = option.name | downcase -%}
  {%- if opt_name contains 'size' -%}
    <div class="product-option mf-unitprice-row">
      <dt>Each:</dt>
      <dd>
        {%- if mf_discount_active -%}
          {{ item.final_price | money }}
        {%- else -%}
          {{ item.original_price | money }}
        {%- endif -%}

        {%- if mf_discount_active and item.original_price > item.final_price -%}
          <span class="mf-unitprice-compare"><s>{{ item.original_price | money }}</s></span>
        {%- endif -%}
      </dd>
    </div>
  {%- endif -%}
{%- endfor -%}

                          {%- endif -%}

                          {%- for property in item.properties -%}
                            {%- assign property_first_char = property.first | slice: 0 -%}
                            {%- if property.last != blank and property_first_char != '_' -%}
                              <div class="product-option">
                                <dt>{{ property.first }}:</dt>
                                <dd>
                                  {%- if property.last contains '/uploads/' -%}
                                    <a href="{{ property.last }}" class="link" target="_blank">
                                      {{ property.last | split: '/' | last }}
                                    </a>
                                  {%- else -%}
                                    {{ property.last }}
                                  {%- endif -%}
                                </dd>
                              </div>
                            {%- endif -%}
                          {%- endfor -%}
                        </dl>

                        {%- if item.selling_plan_allocation != null -%}
                          <p class="product-option">{{ item.selling_plan_allocation.selling_plan.name }}</p>
                        {%- endif -%}
                      {%- endif -%}
                    </td>

                    <!-- Mobile Totals -->
                    <td class="cart-item__totals right medium-hide large-up-hide">
                      {%- render 'loading-spinner' -%}
                      <div class="cart-item__price-wrapper">
                        <div class="mf-line-total">
                          {%- if mf_discount_active -%}
                            {{ mf_line_paid_cents | money }}
                          {%- else -%}
                            {{ mf_line_retail_cents | money }}
                          {%- endif -%}
                        </div>
                        {%- if mf_has_compare -%}
                          <span class="mf-line-compare"><s>{{ mf_line_retail_cents | money }}</s></span>
                        {%- endif -%}
                      </div>
                    </td>

                    <!-- Quantity -->
                    <td class="cart-item__quantity cart-item__quantity--info">
                      <quantity-popover>
                        <div class="cart-item__quantity-wrapper quantity-popover-wrapper">
                          <label class="visually-hidden" for="Quantity-{{ item.index | plus: 1 }}">
                            {{ 'products.product.quantity.label' | t }}
                          </label>

                          <div class="quantity-popover-container quantity-popover-container--hover">
                            <button
                              type="button"
                              aria-expanded="false"
                              class="quantity-popover__info-button quantity-popover__info-button--icon-only button button--tertiary small-hide medium-hide"
                            >
                              {{- 'icon-info.svg' | inline_asset_content -}}
                            </button>

                            <quantity-input
                              class="quantity cart-quantity"
                              data-line-item-key="{{ item.key }}"
                              data-variant-id="{{ item.variant.id }}"
                              data-properties='{{ item.properties | json }}'
                            >
                              <button class="quantity__button" name="minus" type="button">
                                <span class="visually-hidden">{{ 'products.product.quantity.decrease' | t: product: item.product.title | escape }}</span>
                                <span class="svg-wrapper">{{- 'icon-minus.svg' | inline_asset_content -}}</span>
                              </button>

                              <input
                                class="quantity__input"
                                id="Quantity-{{ item.index | plus: 1 }}"
                                data-index="{{ item.index | plus: 1 }}"
                                data-line-key="{{ item.key }}"
                                data-quantity-variant-id="{{ item.variant.id }}"
                                name="updates[]"
                                type="number"
                                value="{{ item.quantity }}"
                                min="{% if mf_single_qty %}1{% else %}3{% endif %}"
                                step="{% if mf_single_qty %}1{% else %}3{% endif %}"
                                data-min="{% if mf_single_qty %}1{% else %}3{% endif %}"
                                data-step="{% if mf_single_qty %}1{% else %}3{% endif %}"
                                data-wholesale="{% if mf_single_qty %}false{% else %}true{% endif %}"
                                aria-label="{{ 'products.product.quantity.input_label' | t: product: item.product.title | escape }}"
                              />

                              <button class="quantity__button" name="plus" type="button">
                                <span class="visually-hidden">{{ 'products.product.quantity.increase' | t: product: item.product.title | escape }}</span>
                                <span class="svg-wrapper">{{- 'icon-plus.svg' | inline_asset_content -}}</span>
                              </button>
                            </quantity-input>
                          </div>

                          <cart-remove-button id="Remove-{{ item.index | plus: 1 }}" data-index="{{ item.index | plus: 1 }}">
                            <a
                              href="{{ item.url_to_remove }}"
                              class="button button--tertiary"
                              aria-label="{{ 'sections.cart.remove_title' | t: title: item.title | escape }}"
                            >
                              <span class="svg-wrapper">{{- 'icon-remove.svg' | inline_asset_content -}}</span>
                            </a>
                          </cart-remove-button>
                        </div>

                        <button type="button" class="quantity-popover__info-button quantity-popover__info-button--icon-with-label button button--tertiary large-up-hide" aria-expanded="false">
                          {{- 'icon-info.svg' | inline_asset_content -}}
                          <span>{{ 'products.product.quantity.note' | t }}</span>
                        </button>

                        <div class="cart-items__info global-settings-popup quantity-popover__info" tabindex="-1" hidden>
                        <div class="quantity__rules caption">
                          {%- assign mf_qty_rule = 3 -%}
                          {%- if mf_single_qty -%}{%- assign mf_qty_rule = 1 -%}{%- endif -%}

                          <span class="divider">{{ 'products.product.quantity.multiples_of' | t: quantity: mf_qty_rule }}</span>
                          <span class="divider">{{ 'products.product.quantity.min_of' | t: quantity: mf_qty_rule }}</span>
                        </div>
                          <button class="button-close button button--tertiary large-up-hide" type="button" aria-label="{{ 'accessibility.close' | t }}">
                            <span class="svg-wrapper">{{- 'icon-close.svg' | inline_asset_content -}}</span>
                          </button>
                        </div>

                        <div class="cart-item__error" id="Line-item-error-{{ item.index | plus: 1 }}" role="alert">
                          <small class="cart-item__error-text"></small>
                          <span class="svg-wrapper">{{- 'icon-error.svg' | inline_asset_content -}}</span>
                        </div>
                      </quantity-popover>
                    </td>

                    <!-- Desktop Totals -->
                    <td class="cart-item__totals right small-hide">
                      {%- render 'loading-spinner' -%}
                      <div class="cart-item__price-wrapper">
                        <div class="mf-line-total">
                          {%- if mf_discount_active -%}
                            {{ mf_line_paid_cents | money }}
                          {%- else -%}
                            {{ mf_line_retail_cents | money }}
                          {%- endif -%}
                        </div>
                        {%- if mf_has_compare -%}
                          <span class="mf-line-compare"><s>{{ mf_line_retail_cents | money }}</s></span>
                        {%- endif -%}
                      </div>
                    </td>
                  </tr>
                {%- endfor -%}
              </tbody>
            </table>
          {%- endif -%}
        </div>
      </div>

      <p class="visually-hidden" id="cart-live-region-text" aria-live="polite" role="status"></p>
      <p class="visually-hidden" id="shopping-cart-line-item-status" aria-live="polite" aria-hidden="true" role="status">
        {{ 'accessibility.loading' | t }}
      </p>
    </form>
  </div>
</cart-items>
<script>
  (function () {
    function getRules(input) {
      var step = parseInt(input.getAttribute('step') || input.dataset.step || '1', 10);
      var min  = parseInt(input.getAttribute('min')  || input.dataset.min  || '0', 10);
      if (!Number.isFinite(step) || step < 1) step = 1;
      if (!Number.isFinite(min) || min < 0) min = 0;
      return { step: step, min: min };
    }

    function normalizedValue(input) {
      var rules = getRules(input);
      var raw = String((input.value || '')).trim();
      var v = parseInt(raw, 10);
      if (!Number.isFinite(v)) v = rules.min || rules.step;

      v = Math.max(rules.min, v);

      if (rules.step > 1) {
        v = Math.round(v / rules.step) * rules.step;
        if (v < rules.min) v = rules.min;
      }

      return { raw: raw, val: v };
    }

    // 1) Prevent Enter from submitting the cart form (the "jump" you saw)
    document.addEventListener('keydown', function (e) {
      var t = e.target;
      if (!t) return;
      if (t.matches('input.quantity__input') && e.key === 'Enter') {
        e.preventDefault();
        e.stopPropagation();
        // Let the change event do its thing; just blur so it commits
        t.blur();
        return false;
      }
    }, true);

    // 2) Normalize once INSIDE the real change event so we don't cause a second update
    document.addEventListener('change', function (e) {
      var input = e.target;
      if (!input || !input.matches('input.quantity__input')) return;

      // guard: if we're the ones re-firing, don't loop
      if (input.dataset.mfRefire === '1') {
        input.dataset.mfRefire = '0';
        return;
      }

      var n = normalizedValue(input);

      // If already valid, do nothing (prevents double refresh)
      if (n.raw === String(n.val)) return;

      // If we need to correct it, stop this change and fire exactly one corrected change
      e.preventDefault();
      e.stopImmediatePropagation();

      input.value = n.val;
      input.dataset.mfRefire = '1';
      input.dispatchEvent(new Event('change', { bubbles: true }));
    }, true);

  })();
</script>


{% schema %}
{
  "name": "t:sections.main-cart-items.name",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-1" },
    { "type": "header", "content": "t:sections.all.padding.section_padding_heading" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_top", "default": 36 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_bottom", "default": 36 }
  ]
}


{% endschema %}
