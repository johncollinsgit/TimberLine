* text=auto eol=lf

*.blade.php diff=html
*.css diff=css
*.html diff=html
*.md diff=markdown
*.php diff=php

CHANGELOG.md export-ignore
README.md export-ignore
.github/workflows/browser-tests.yml export-ignore

# Preserve upstream browser libraries verbatim and keep review focused on app code.
public/studio/transformers.web.js linguist-vendored -whitespace
public/studio/vendor/** linguist-vendored -whitespace

# Pinned, licensed standalone visualizer; demo integration remains first-party.
public/avery-visualizer/viewer*.js linguist-vendored -whitespace
public/avery-visualizer/hand-scene-*.js linguist-vendored -whitespace
public/avery-visualizer/assets/** linguist-vendored -whitespace
public/avery-visualizer/runtime/** linguist-vendored -whitespace
